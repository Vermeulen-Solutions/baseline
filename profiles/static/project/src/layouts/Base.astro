---
import SiteShell from './SiteShell.astro';
// Opt-in composition, type and motion capabilities; nothing applies until a page uses them.
import '../styles/expressive.css';
import { site } from '../config/site';
import { routing } from '../config/routing';
import StaticMetadata from '../components/StaticMetadata.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { resolveStaticMetadata, routePath, type PageMetadata } from '../lib/metadata';
import { gatedRoutes } from '../lib/posts';
type Props = PageMetadata & {
  surface?: 'light' | 'dark' | 'system';
};
const { surface, ...pageProps } = Astro.props;
const metadata = resolveStaticMetadata(pageProps, site, { siteUrl: Astro.site, url: Astro.url, routing });
// Sections with nothing published yet stay out of the menu (src/lib/posts.ts gatedRoutes).
const gated = new Set(await gatedRoutes());
const navigation = site.navigation
  .map(item => ({ ...item, href: item.href.startsWith('/') && !item.href.startsWith('//') ? routePath(item.href, routing) : item.href }))
  .filter(item => !gated.has(item.href));
---
<SiteShell spacingPolicy="automatic-v2" sectionJoins="shared" pageTransitions="cross-document" prefetch="moderate" title={metadata.title} metadataOwner="platform" lang={metadata.language} surface={surface}>
  <Fragment slot="head">
    <StaticMetadata metadata={metadata} />
    <link rel="icon" type="image/svg+xml" href={routePath('/favicon.svg', routing)} />
    {/* From `npm run icons`: the home-screen icon iOS asks for, and the manifest with the app icons. */}
    <link rel="apple-touch-icon" href={routePath('/apple-touch-icon.png', routing)} />
    <link rel="manifest" href={routePath('/site.webmanifest', routing)} />
  </Fragment>
  <header slot="header" class="site-header" data-sticky-header data-vt-header>
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="site-brand" href={routePath('/', routing)}>{site.title}</a>
      {/* One disclosure holds the links: a Menu control on phones, the same links inline from 48rem
          (see .site-menu in global.css). It works without JavaScript. */}
      <details class="site-menu">
        <summary class="site-menu__toggle">Menu</summary>
        <div class="site-menu__panel">
          {navigation.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
    </nav>
  </header>
  <slot />
  <footer slot="footer" class="site-footer"><p>Built with Astro and Baseline.</p></footer>
  {/* Nothing renders until PUBLIC_GA_ID, PUBLIC_GTM_ID or PUBLIC_CF_BEACON_TOKEN is set (src/lib/consent.ts). */}
  <Analytics slot="body-end" />
  <ConsentBanner slot="body-end" />
</SiteShell>
