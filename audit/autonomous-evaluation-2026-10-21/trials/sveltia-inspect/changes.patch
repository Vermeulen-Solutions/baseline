+
+test('optional reading minutes use the same integer boundaries in the schema and editor', () => {
+  const config = JSON.parse(fs.readFileSync('public/admin/config.yml', 'utf8'));
+  const field = config.collections.find(c => c.name === 'posts').fields.find(f => f.name === 'readingMinutes');
+  assert.equal(field.value_type, 'int');
+  assert.equal(field.min, 1);
+  assert.equal(field.max, 60);
+  assert.equal(field.step, 1);
+  assert.equal(field.required, false);
+  assert.ok(!Object.hasOwn(field, 'default'));
+  for (const value of [undefined, 1, 30, 60]) {
+    assert.equal(readingMinutesSchema.safeParse(value).success, true, `accept ${value}`);
+  }
+  for (const value of [0, -1, 61, 1.5, 59.9, '5', '', null, true, NaN, Infinity]) {
+    assert.equal(readingMinutesSchema.safeParse(value).success, false, `reject ${value}`);
+  }
+});
