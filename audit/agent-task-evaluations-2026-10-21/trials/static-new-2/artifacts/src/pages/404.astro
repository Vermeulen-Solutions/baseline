---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import { routing } from '../config/routing';
import { routePath } from '../lib/metadata';
---
<Base title="Not Found" canonical={null} robots="noindex, nofollow"><Section labelledBy="not-found"><Container width="reading">
  <h1 id="not-found">Page not found</h1><p>The page you're looking for doesn't exist.</p><a href={routePath('/', routing)}>Go home</a>
</Container></Section></Base>
