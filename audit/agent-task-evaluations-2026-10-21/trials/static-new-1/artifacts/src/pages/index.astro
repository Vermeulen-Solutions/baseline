---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import RichText from '../components/RichText.astro';
import ProjectAction from '../components/ProjectAction.astro';
import ServicesList from '../components/ServicesList.astro';
const entry = await getEntry('pages', 'home');
if (!entry || entry.data.draft) throw new Error('A published home page is required.');
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <Section class="home-intro" labelledBy="page-heading">
    <Container layout="custom" class="intro-grid">
      <h1 id="page-heading">{entry.data.heading}</h1>
      <div class="intro-copy"><RichText><Content /></RichText><ProjectAction /></div>
    </Container>
  </Section>
  <Section class="services-section" labelledBy="services-heading">
    <Container>
      <h2 id="services-heading">How we can help</h2>
      <ServicesList />
      <a class="text-link" href="/services/">Explore our services</a>
    </Container>
  </Section>
</Base>
