---
import { getCollection } from 'astro:content';
const services = (await getCollection('services', ({ data }) => !data.draft)).sort((a,b)=>a.data.order-b.data.order);
---
<dl class="services-list">
  {services.map(service => <div class="service-row"><dt>{service.data.title}</dt><dd>{service.data.description}</dd></div>)}
</dl>
