---
interface Props { message: string; fields?: {id:string;label:string}[]; id?:string; autofocus?: boolean; }
const { message, fields = [], id = 'form-errors', autofocus = false } = Astro.props;
---
{/* eslint-disable-next-line astro/jsx-a11y/no-autofocus -- Opt-in focus after server validation; default off, keyboard recovery verified in Phase 3. */}
<div class="form-error" role="alert" id={id} tabindex="-1" autofocus={autofocus || undefined}><p>{message}</p>{fields.length>0 && <ul>{fields.map(field=><li><a href={`#${field.id}`}>{field.label}</a></li>)}</ul>}</div>
<style>
@layer components {
.form-error { padding:var(--spacing-content); border:1px solid var(--color-border); border-radius:var(--radius-control); background:var(--color-surface); color:var(--color-text); }
ul { margin-top:var(--spacing-content); padding-inline-start:1.5rem; }
}
</style>
