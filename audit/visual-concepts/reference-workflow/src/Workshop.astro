---
import Container from '../../../../src/components/Container.astro';
import Grid from '../../../../src/components/Grid.astro';
import '../../../../src/styles/global.css';
const { mode = 'flat' } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Open Workshop — synthetic translation example</title></head>
<body data-mode={mode}>
  <header>
    <svg viewBox="0 0 64 32" width="64" height="32" role="img" aria-label="Synthetic workshop mark"><path fill="#176ca4" d="M0 0h32v32H0z"/><path fill="#d26935" d="M32 0h32v32H32z"/><circle fill="#f9d976" cx="32" cy="16" r="10"/></svg>
    <span>Open Workshop · synthetic workflow fixture</span>
  </header>
  <main><Container><div class="flow">
    <h1>Tools for making things together</h1>
    <p data-copy lang="de">Gemeinsam gestalten wir zugängliche Werkzeuge für verantwortungsvolle Zusammenarbeit über Organisationsgrenzen hinweg.</p>
    <Grid minimum="compact">
      <article class="flow"><h2>Materials</h2><p>Reusable tools and shared notes.</p></article>
      <article class="flow"><h2>Sessions</h2><p>Small groups. Clear outcomes.</p></article>
      <article class="flow"><h2>Visit</h2><address>Example Workshop<br />12 Example Street</address></article>
    </Grid>
  </div></Container></main>
</body></html>
<style>
  header { display:flex; align-items:center; gap:var(--spacing-content); padding:var(--spacing-content); border-block-end:1px solid var(--color-border); }
  header svg { flex:none; }
  main { padding:var(--spacing-section) var(--spacing-container); }
  h1 { max-inline-size:20ch; }
  article { min-inline-size:0; padding:var(--spacing-content); border:1px solid var(--color-border); background:var(--color-surface); }
  address { font-style:normal; }
  [data-copy] { overflow-wrap:anywhere; }
</style>
