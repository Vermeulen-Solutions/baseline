{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Baseline Starter",
		"description": "Baseline starter with EmDash CMS, design tokens, layout primitives, and structured content",
		"author": "Baseline"
	},
	"settings": {
		"title": "My Site",
		"tagline": "Built with Baseline and EmDash"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"supports": ["drafts", "revisions", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "search"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "general",
					"label": "General"
				},
				{
					"slug": "updates",
					"label": "Updates"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "starter",
					"label": "Starter"
				},
				{
					"slug": "example",
					"label": "Example"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Home",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "Posts",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/about"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5
					}
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This is the about page. Edit it in the admin panel or customize it using Baseline layout primitives and design tokens.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-1",
				"slug": "welcome",
				"status": "published",
				"data": {
					"title": "Welcome",
					"excerpt": "A starter post using the Baseline design system and EmDash CMS.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This is a starter post built with Baseline and EmDash CMS. The templates demonstrate core patterns for querying, rendering, and editing structured content with fluid typography, design tokens, and .flow rhythm.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "What to do next",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"listItem": "number",
							"level": 1,
							"children": [
								{
									"_type": "span",
									"text": "Replace the starter content with your own in the EmDash admin panel.",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"listItem": "number",
							"level": 1,
							"children": [
								{
									"_type": "span",
									"text": "Establish the site's art direction before changing its visual identity.",
									"_key": "k7"
								}
							],
							"_key": "k6"
						},
						{
							"_type": "block",
							"style": "normal",
							"listItem": "number",
							"level": 1,
							"children": [
								{
									"_type": "span",
									"text": "Calibrate shared components on the development styleguide at /_styleguide.",
									"_key": "k9"
								}
							],
							"_key": "k8"
						}
					]
				},
				"taxonomies": {
					"category": ["general"],
					"tag": ["starter", "example"]
				}
			}
		]
	}
}
