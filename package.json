{
  "name": "emdash-baseline",
  "version": "0.0.3",
  "description": "The visual-first Astro toolkit for EmDash CMS and AI-assisted developers: live Dev HUD, component quarantine, schema safeguards, and local visual regression.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vermeulen-Solutions/emdash-baseline.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "start:local": "node --env-file=.env ./dist/server/entry.mjs",
    "prebuild": "npm run check:schema-budget",
    "build": "astro build",
    "pretypecheck": "npm run check:schema-budget",
    "typecheck": "astro check",
    "check:schema-budget": "node scripts/check-schema-budget.mjs",
    "audit:baseline": "node scripts/audit-baseline.mjs",
    "test:baseline": "node --test tests/audit-baseline.test.mjs",
    "check:dev-tools": "node scripts/check-dev-tools.mjs",
    "check:art-direction": "node scripts/check-art-direction.mjs --changed",
    "test:design": "node --test tests/design-workflow.test.mjs",
    "test:schema-budget": "node --test tests/schema-column-budget.test.mjs",
    "sync:emdash-skills": "node scripts/sync-emdash-skills.mjs",
    "sync:site-skills": "node scripts/sync-site-skills.mjs",
    "test:galleries": "node --test tests/photo-gallery.test.mjs tests/justified-gallery.test.mjs",
    "test:utilities": "node --test tests/form-recovery.test.mjs tests/partners.test.mjs",
    "check:docs-mcp": "node scripts/check-docs-mcp.mjs",
    "check:native-images": "node scripts/check-native-images.mjs",
    "media:organize": "node scripts/organize-media.mjs",
    "media:sync-r2": "node scripts/sync-r2-media.mjs",
    "mcp:token": "node scripts/create-mcp-token.mjs",
    "check:upstream": "node scripts/check-upstream-updates.mjs",
    "site:register": "node scripts/register-site.mjs",
    "test:maintenance": "node --test tests/skill-sync.test.mjs tests/meta-review.test.mjs tests/design-interchange.test.mjs",
    "design:check": "node scripts/design-interchange.mjs",
    "design:export": "node scripts/design-interchange.mjs --export",
    "build:timings": "astro build --timings",
    "postbuild": "node scripts/assert-release-artifact.mjs",
    "prestart": "node scripts/assert-release-artifact.mjs",
    "prestart:local": "node scripts/assert-release-artifact.mjs",
    "fixtures:build": "node scripts/styleguide-fixtures.mjs build",
    "fixtures:serve": "node scripts/styleguide-fixtures.mjs serve",
    "check:release-artifact": "node scripts/assert-release-artifact.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:sensitivity": "node scripts/test-visual.mjs --sensitivity",
    "test:visual:functional": "node scripts/test-visual.mjs --functional",
    "check:visual-cleanup": "node tests/visual/cleanup-check.mjs",
    "lint": "node scripts/check-script-syntax.mjs",
    "test:dev-hud": "playwright test --config=playwright.dev-tools.config.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "test:site-audit": "node --test tests/site-standards-audit.test.mjs tests/audit-coverage.test.mjs tests/audit-modernize.test.mjs tests/audit-runtime-evidence.test.mjs",
    "audit:modernize": "node scripts/audit-modernize.mjs",
    "audit:pilot": "node scripts/rehearse-site-audit.mjs",
    "db:diff": "node scripts/db-diff.mjs",
    "db:export-seed": "node scripts/db-export-seed.mjs",
    "db:pull-remote": "node scripts/d1-snapshot.mjs",
    "test:database": "node --test tests/database-tooling.test.mjs",
    "media:migrate-wp": "node scripts/media-migrate-wp.mjs",
    "test:media-infrastructure": "node --test tests/media-infrastructure.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/react": "7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.0",
    "emdash": "1.3.0",
    "photoswipe": "^5.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/noto-sans": "5.3.0",
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.64.1",
    "aws4fetch": "1.0.20",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.4",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
