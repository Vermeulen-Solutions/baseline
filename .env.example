# Optional during local development; required for hosted CMS image authorization,
# native public form Origin checks and the canonical EmDash origin.
# Set the actual site origin in the production build environment.
# SITE_URL=https://your-site.example

# Generate EmDash secrets into your ignored .env with:
# npx emdash secrets generate --write .env

# Optional build-time page redirects; enable only after checking lowercase slugs
# and custom endpoint exclusions. Never normalize asset or CMS storage URLs.
# NORMALIZE_PAGE_URLS=1
