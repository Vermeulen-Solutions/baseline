---
import { getEmDashCollection, getSiteSettingsWithCacheHint } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
const { data: settings, cacheHint: settingsCacheHint } = await getSiteSettingsWithCacheHint();
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);
if (Astro.cache?.enabled) Astro.cache.set(settingsCacheHint);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline} breadcrumbs={[]} organization>
	<Section labelledBy="recent-posts">
		<h1 id="recent-posts">Recent Posts</h1>

		{
			posts.length === 0 ? (
				<p>No posts yet.</p>
			) : (
				/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles -- Safari needs the role when visual list markers are removed. */
				<ul role="list" class="collection-list">
					{posts.map((post) => (
						<li class="collection-item">
							<a href={`/posts/${post.id}`}>
								{post.data.featured_image && (
									<Image image={post.data.featured_image} />
								)}
								<h2>{post.data.title}</h2>
							</a>
							{post.data.excerpt && <p>{post.data.excerpt}</p>}
							{post.data.publishedAt && (
								<time datetime={post.data.publishedAt.toISOString()}>
									{post.data.publishedAt.toLocaleDateString("en-US", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})}
								</time>
							)}
						</li>
					))}
				</ul>
			)
		}
	</Section>
</Base>
