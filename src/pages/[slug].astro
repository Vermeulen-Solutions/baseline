---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettingsWithCacheHint } from "emdash";

import Base from "../layouts/Base.astro";
import RichText from "../components/RichText.astro";
import Section from "../components/Section.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { resolvePublicSiteUrl } from "../utils/page-metadata";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

const { data: settings, cacheHint: settingsCacheHint } = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(settingsCacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: resolvePublicSiteUrl(settings.url, Astro.site, Astro.url),
	titleSeparator: settings.seo?.titleSeparator,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<Section labelledBy="page-title">
		<article class="flow">
			<h1 id="page-title" {...page.edit.title}>{page.data.title}</h1>

			<div class="flow article-body">
				<RichText value={page.data.content} />
			</div>
		</article>
	</Section>
</Base>
