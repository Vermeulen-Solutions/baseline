---
import { getTerm, getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import PostListItem from "../../components/PostListItem.astro";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { taxonomyRobots } from '../../lib/structured-data';

const slug = decodeSlug(Astro.params.slug);
// Keep getTerm's hierarchical/deep-link and locale fallback semantics.
const term = slug ? await getTerm('tag', slug, { includeCounts: false }) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});
if (Astro.cache?.enabled) {
  const { cacheHint: taxonomyCacheHint } = await getTaxonomyTermsWithCacheHint('tag', { includeCounts: false });
  Astro.cache.set(cacheHint);
  Astro.cache.set(taxonomyCacheHint);
}
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`Posts tagged ${term.label}`}
	seo={{ robots: taxonomyRobots(posts.length) }}
	breadcrumbs={[{ name: 'Home', url: '/' }, { name: term.label, url: Astro.url.pathname }]}
>
	<Section labelledBy="tag-heading">
		<h1 id="tag-heading">Tag: {term.label}</h1>
		<p>{posts.length} {posts.length === 1 ? "post" : "posts"}</p>

		{
			posts.length === 0 ? (
				<p>No posts with this tag yet.</p>
			) : (
				/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles -- Safari needs the role when visual list markers are removed. */
				<ul role="list" class="collection-list">
					{posts.map((post) => (
						<PostListItem post={post} />
					))}
				</ul>
			)
		}
	</Section>
</Base>
