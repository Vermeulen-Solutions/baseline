---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettingsWithCacheHint } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import RichText from "../../components/RichText.astro";
import Section from "../../components/Section.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { articleMetadata, resolvePublicSiteUrl } from "../../utils/page-metadata";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

const { data: settings, cacheHint: settingsCacheHint } = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(settingsCacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: resolvePublicSiteUrl(settings.url, Astro.site, Astro.url),
	titleSeparator: settings.seo?.titleSeparator,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	pageType="article"
	breadcrumbs={[{ name: 'Home', url: '/' }, ...categories.slice(0, 1).map(c => ({ name: c.label, url: '/category/' + encodeURIComponent(c.slug) })), { name: post.data.title, url: seo.canonical || Astro.url.pathname }]}
	articleMeta={articleMetadata(post.data)}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<Section labelledBy="post-title">
		<article class="article-stack">
			{
				post.data.featured_image && (
					<div {...post.edit.featured_image}>
						<Image image={post.data.featured_image} />
					</div>
				)
			}

			<h1 id="post-title" {...post.edit.title}>{post.data.title}</h1>

			{
				post.data.publishedAt && (
					<time datetime={post.data.publishedAt.toISOString()}>
						{post.data.publishedAt.toLocaleDateString("en-US", {
							year: "numeric",
							month: "long",
							day: "numeric",
						})}
					</time>
				)
			}

			{
				categories.length > 0 && (
					<div class="article-taxonomies">
						{categories.map((c) => (
							<a href={`/category/${c.slug}`}>{c.label}</a>
						))}
					</div>
				)
			}

			<div class="article-body">
				<RichText value={post.data.content} />
			</div>

			{
				tags.length > 0 && (
					<div class="article-taxonomies">
						{tags.map((t) => (
							<a href={`/tag/${t.slug}`}>{t.label}</a>
						))}
					</div>
				)
			}
		</article>
	</Section>
</Base>
