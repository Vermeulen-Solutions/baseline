---
import { PortableText } from 'emdash/ui';
import { getEditMeta } from 'emdash';
import EditorialImage from './EditorialImage.astro';
import PhotoGallery from './PhotoGallery.astro';
import PortableTextHeading from './PortableTextHeading.astro';
import { decoratePortableHeadingBlocks } from '../lib/emdash-headings.ts';

interface Props {
  value: any;
  class?: string;
  flow?: boolean;
  scopeId?: string;
  [key: string]: any;
}
const { value, class: className, flow = true, scopeId, ...attributes } = Astro.props;
const hasWrapper = Boolean(flow || className || Object.keys(attributes).length > 0);
const meaningful = (input: any): boolean => Array.isArray(input) ? input.some(meaningful) : input && typeof input === 'object' ? input._type === 'span' ? Boolean(input.text?.trim()) : input._type === 'block' ? meaningful(input.children) : Boolean(input._type) : typeof input === 'string' && Boolean(input.trim());
// Query-attached metadata is required even for an empty live editor field.
const renderContent = meaningful(value) || Boolean(getEditMeta(value)) || Object.keys(attributes).some(key => key.startsWith('data-emdash-'));

// Explicit scope override only; wrapper HTML id attribute must never override heading namespace
const effectiveScopeId = typeof scopeId === 'string' && scopeId.trim() ? scopeId.trim() : undefined;
if (Array.isArray(value)) {
  decoratePortableHeadingBlocks(value, effectiveScopeId);
}

const portableTextComponents = {
  type: {
    image: EditorialImage,
    gallery: PhotoGallery,
  },
  block: {
    h1: PortableTextHeading,
    h2: PortableTextHeading,
    h3: PortableTextHeading,
    h4: PortableTextHeading,
    h5: PortableTextHeading,
    h6: PortableTextHeading,
  },
};
---
{renderContent && (hasWrapper ? (
  <div {...attributes} data-editorial-content={flow ? '' : undefined} class:list={[flow && 'flow', className]}>
    <PortableText value={value} components={portableTextComponents} />
  </div>
) : (
  <PortableText value={value} components={portableTextComponents} />
))}
