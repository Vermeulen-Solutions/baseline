---
interface Props {
	minimum?: "compact" | "standard" | "wide";
	class?: string;
}

const { minimum: rawMinimum, class: className } = Astro.props;
const minimum = rawMinimum === 'compact' || rawMinimum === 'wide' ? rawMinimum : 'standard';
---

<div class:list={["grid-auto", `grid-auto--${minimum}`, className]}>
	<slot />
</div>
