---
interface Props {
	minimum?: "compact" | "standard" | "wide";
	gap?: string;
	class?: string;
}

const { minimum: rawMinimum, gap, class: className } = Astro.props;
const minimum = rawMinimum === 'compact' || rawMinimum === 'wide' ? rawMinimum : 'standard';
---

<div
	class:list={["grid-auto", `grid-auto--${minimum}`, className]}
	style={gap ? `--grid-gap:${gap}` : undefined}
>
	<slot />
</div>
