---
/**
 * Opening hours as a table, from the same list the Organization structured data uses
 * (`openingHours` in the baseline-metadata plugin's `options.organization` on EmDash sites), so the
 * page and search engines never disagree. Keep the list in one shared module and pass it to both.
 * Day names and times follow the page locale; a day without an entry reads as closed.
 */
import { openingHoursRows, type OpeningHours } from '../lib/opening-hours';

interface Props {
  hours: OpeningHours[];
  /** BCP 47 locale for day names and times, e.g. 'fr-CH'. */
  locale?: string;
  /** Text for a day with no hours. */
  closedLabel?: string;
  caption?: string;
  /** Hide the caption visually but keep it for screen readers. */
  hideCaption?: boolean;
  class?: string;
}

const { hours, locale = 'en', closedLabel = 'Closed', caption = 'Opening hours', hideCaption = false, class: className } = Astro.props;
const rows = openingHoursRows(hours, locale);
---
<table class:list={['hours', className]}>
  <caption class:list={{ 'sr-only': hideCaption }}>{caption}</caption>
  <tbody>
    {rows.map(row => (
      <tr>
        <th scope="row">{row.day}</th>
        <td>{row.times.length ? row.times.join(', ') : closedLabel}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
@layer components {
  .hours { border-collapse: collapse; inline-size: 100%; max-inline-size: 28rem; }
  .hours caption { text-align: start; font-weight: 600; padding-block-end: var(--spacing-2xs, 0.5rem); }
  .hours th, .hours td { text-align: start; padding-block: var(--spacing-3xs, 0.25rem); border-block-end: 1px solid var(--color-border); }
  .hours th { font-weight: 400; padding-inline-end: var(--spacing-s, 1rem); }
  .hours td { font-variant-numeric: tabular-nums; }
}
</style>
