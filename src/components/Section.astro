---
interface Props {
	labelledBy: string;
	spacing?: "content" | "section";
	class?: string;
}

const { labelledBy: rawLabel, spacing: rawSpacing, class: className } = Astro.props;
const labelledBy = typeof rawLabel === 'string' && rawLabel.trim() ? rawLabel.trim() : undefined;
const spacing = rawSpacing === 'content' ? 'content' : 'section';
---

<section aria-labelledby={labelledBy} class:list={["section", `section--${spacing}`, className]}>
	<slot />
</section>

<style>
	.section--content {
		padding-block: var(--spacing-content);
	}

	.section--section {
		padding-block: var(--spacing-section);
	}
</style>
