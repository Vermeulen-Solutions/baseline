---
/**
 * A map that loads nothing from the map provider until the visitor asks for it. A short address
 * line and a "Show map" button stand in; one click swaps in the embedded map. The link to the full
 * map stays, and without JavaScript the button is that link. Pass the provider's embed URL (an
 * OpenStreetMap export embed, or a Google Maps embed) and the URL of the place on the provider.
 * Name the provider in the privacy notice as embedded content loaded on click.
 */
interface Props {
  /** The provider's embed URL (https only). */
  embed: string;
  /** The place on the provider, opened in a new tab or without JavaScript. */
  href: string;
  /** What the map shows; it names the frame. */
  title: string;
  /** Address or directions shown before the map loads. */
  address?: string;
  showLabel?: string;
  openLabel?: string;
  aspectRatio?: string;
}

const { embed, href, title, address, showLabel = 'Show map', openLabel = 'Open in maps', aspectRatio = '4 / 3' } = Astro.props;
const https = (value: string) => { try { return new URL(value).protocol === 'https:' ? value : ''; } catch { return ''; } };
const src = https(embed);
const link = https(href);
---
{src && link && (
  <figure class="map-embed" style={`aspect-ratio: ${aspectRatio}`} data-load-iframe={src} data-load-title={title}>
    <div class="map-embed__placeholder">
      {address && <p class="map-embed__address">{address}</p>}
      <a class="map-embed__show" href={link} data-load-trigger>{showLabel}</a>
    </div>
    <figcaption class="map-embed__caption"><a href={link} target="_blank" rel="noopener noreferrer">{openLabel}</a></figcaption>
  </figure>
)}

<script>
  import { setupLoadOnClick } from '../lib/load-on-click';
  setupLoadOnClick();
  document.addEventListener('astro:page-load', () => setupLoadOnClick());
</script>

<style>
@layer components {
  .map-embed { position: relative; margin: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-card, 0.75rem); background: var(--color-elevated, var(--color-surface)); }
  .map-embed__placeholder { position: absolute; inset: 0 0 2.75rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-2xs, 0.5rem); padding: var(--spacing-s, 1rem); text-align: center; }
  .map-embed__address { margin: 0; }
  .map-embed__show { display: inline-flex; align-items: center; min-block-size: 2.75rem; padding-inline: var(--spacing-s, 1rem); border: 1px solid var(--color-border-strong); border-radius: var(--radius-control, 0.375rem); background: var(--color-surface); color: var(--color-text); text-decoration: none; font-weight: 600; }
  .map-embed :global(iframe) { position: absolute; inset: 0 0 2.75rem; inline-size: 100%; block-size: calc(100% - 2.75rem); border: 0; }
  .map-embed__caption { position: absolute; inset: auto 0 0; display: flex; align-items: center; justify-content: flex-end; block-size: 2.75rem; padding-inline: var(--spacing-s, 1rem); background: var(--color-surface); border-block-start: 1px solid var(--color-border); }
}
</style>
