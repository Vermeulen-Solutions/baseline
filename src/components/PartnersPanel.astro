---
import { publicLink } from '../lib/public-link';
import type { Partner } from '../lib/partner';
interface Props { partners: Partner[]; }
const { partners } = Astro.props;
---
{partners.length > 0 && <div class="partners-panel">{partners.map(partner=>{
 const href = publicLink(partner.href);
 const Tag = href ? 'a' : 'div';
 return <Tag href={href} class="partner-tile" aria-label={href ? partner.name : undefined}><span class:list={['partner-art',{'partner-art--dark':partner.ground==='dark'}]}><img src={partner.image} alt={partner.alt} loading="lazy" decoding="async" /></span></Tag>;
})}</div>}
<style>
.partners-panel { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr)); gap:var(--spacing-content); }
.partner-tile { display:flex; align-items:center; justify-content:center; min-height:8rem; padding:var(--spacing-content); background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-card); }
.partner-art { display:flex; align-items:center; justify-content:center; width:100%; min-height:5rem; padding:.5rem; background:white; }
.partner-art--dark { background:#171717; }
.partner-art img { max-width:100%; max-height:5rem; object-fit:contain; }
a.partner-tile:is(:hover,:focus-visible) { border-color:var(--color-action); }
@media (hover:hover) and (prefers-reduced-motion:no-preference) { a.partner-tile img { transition:transform .18s ease-out; } a.partner-tile:hover img { transform:scale(1.03); } }
</style>
