---
export interface Props {
  id?: string;
  targetId: string;
  label?: string;
  copiedLabel?: string;
  copiedMessage?: string;
  errorMessage?: string;
  announcerId?: string;
  source?: 'text' | 'value';
  timeout?: number;
  excludeSelector?: string;
}

const {
  id,
  targetId,
  label = 'Copy to clipboard',
  copiedLabel = 'Copied!',
  copiedMessage = 'Copied to clipboard',
  errorMessage = 'Failed to copy',
  announcerId = 'site-announcer',
  source = 'text',
  timeout = 2000,
  excludeSelector,
} = Astro.props as Props;

if (!targetId) {
  throw new Error('CopyButton requires an explicit "targetId" prop.');
}
---

<button
  type="button"
  id={id}
  class="copy-button"
  data-copy-button
  data-target-id={targetId}
  data-initial-label={label}
  data-copied-label={copiedLabel}
  data-copied-message={copiedMessage}
  data-error-message={errorMessage}
  data-announcer-id={announcerId}
  data-source={source}
  data-timeout={timeout}
  data-exclude-selector={excludeSelector}
  aria-label={label}
>
  <span class="copy-button__text" data-copy-text>{label}</span>
</button>

<script>
  import { copyText, extractCopyableText } from '../lib/clipboard';
  import { announce } from '../lib/announce';

  interface CopyButtonElement extends HTMLButtonElement {
    _resetTimer?: number;
    _opToken?: number;
    _abortController?: AbortController;
  }

  function cancelPendingOperations(button: CopyButtonElement) {
    if (button._resetTimer) {
      clearTimeout(button._resetTimer);
      delete button._resetTimer;
    }
    if (button._abortController) {
      button._abortController.abort();
      delete button._abortController;
    }
    button._opToken = (button._opToken || 0) + 1;
  }

  function resetCopyButton(button: CopyButtonElement) {
    cancelPendingOperations(button);
    button.removeAttribute('data-state');
    const initialLabel = button.getAttribute('data-initial-label') || 'Copy to clipboard';
    const textSpan = button.querySelector<HTMLElement>('[data-copy-text]');
    if (textSpan && textSpan.textContent !== initialLabel) {
      textSpan.textContent = initialLabel;
    }
  }

  function initCopyButtons() {
    const buttons = document.querySelectorAll<CopyButtonElement>('[data-copy-button]');

    buttons.forEach((button) => {
      if ((button as unknown as { _copyInit?: boolean })._copyInit) return;
      (button as unknown as { _copyInit?: boolean })._copyInit = true;

      button.addEventListener('click', async () => {
        const targetId = button.getAttribute('data-target-id');
        const copiedMessage = button.getAttribute('data-copied-message') || 'Copied to clipboard';
        const errorMessage = button.getAttribute('data-error-message') || 'Failed to copy';
        const announcerId = button.getAttribute('data-announcer-id') || 'site-announcer';
        const source = (button.getAttribute('data-source') as 'text' | 'value') || 'text';
        const timeoutMs = parseInt(button.getAttribute('data-timeout') || '2000', 10);
        const textSpan = button.querySelector<HTMLElement>('[data-copy-text]');
        const copiedLabel = button.getAttribute('data-copied-label') || 'Copied!';
        const excludeSelector = button.getAttribute('data-exclude-selector') || undefined;

        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (!target) return;

        const textToCopy = extractCopyableText(target, { source, excludeSelector });
        if (!textToCopy) return;

        // Cancel previous pending operation and schedule a new operation token
        cancelPendingOperations(button);
        const opToken = button._opToken!;
        const ac = new AbortController();
        button._abortController = ac;

        try {
          await copyText(textToCopy, { signal: ac.signal });

          // Invalidate if button was disconnected or superseded
          if (button._opToken !== opToken || !button.isConnected) return;

          button.setAttribute('data-state', 'copied');
          if (textSpan) textSpan.textContent = copiedLabel;
          announce(announcerId, copiedMessage, { priority: 'polite', signal: ac.signal });

          button._resetTimer = window.setTimeout(() => {
            if (button._opToken !== opToken || !button.isConnected) return;
            resetCopyButton(button);
          }, timeoutMs);
        } catch (err) {
          if (ac.signal.aborted || button._opToken !== opToken || !button.isConnected) return;

          button.setAttribute('data-state', 'error');
          if (textSpan) textSpan.textContent = errorMessage;
          announce(announcerId, errorMessage, { priority: 'assertive', signal: ac.signal });

          button._resetTimer = window.setTimeout(() => {
            if (button._opToken !== opToken || !button.isConnected) return;
            resetCopyButton(button);
          }, timeoutMs);
        }
      });
    });
  }

  if (typeof document !== 'undefined') {
    initCopyButtons();
    document.addEventListener('astro:page-load', initCopyButtons);
    document.addEventListener('astro:before-swap', () => {
      document.querySelectorAll<CopyButtonElement>('[data-copy-button]').forEach(resetCopyButton);
    });

    try {
      const disconnectObserver = new MutationObserver((mutations) => {
        for (const m of mutations) {
          m.removedNodes.forEach((node) => {
            if (node instanceof HTMLElement) {
              if (node.hasAttribute('data-copy-button')) {
                resetCopyButton(node as CopyButtonElement);
              }
              node.querySelectorAll<CopyButtonElement>('[data-copy-button]').forEach(resetCopyButton);
            }
          });
        }
      });

      if (document.body) {
        disconnectObserver.observe(document.body, { childList: true, subtree: true });
      }
    } catch {}
  }
</script>

<style>
  @layer components {
    .copy-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: calc(var(--spacing-content) * 0.25);
      padding: calc(var(--spacing-content) * 0.25) calc(var(--spacing-content) * 0.5);
      font: inherit;
      font-size: var(--text-step--1);
      color: inherit;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-control);
      cursor: pointer;
      user-select: none;
      transition: background 150ms ease, border-color 150ms ease;
    }

    .copy-button:hover {
      background: color-mix(in oklch, currentColor 8%, transparent);
    }

    .copy-button[data-state="copied"] {
      border-color: var(--color-action);
    }

    .copy-button[data-state="error"] {
      border-color: var(--color-error, var(--color-action));
      color: var(--color-error, var(--color-text));
    }
  }
</style>
