---
import type { HeadingRecord, HeadingDepth, TocNode } from '../lib/headings';
import { buildToc } from '../lib/headings';

export interface TableOfContentsProps {
  id?: string;
  label?: string;
  contentId: string;
  headings: readonly HeadingRecord[];
  minDepth?: HeadingDepth;
  maxDepth?: HeadingDepth;
  spy?: boolean;
  offsetIds?: readonly string[];
  class?: string;
}

const {
  id = 'toc',
  label = 'Table of contents',
  contentId,
  headings = [],
  minDepth = 2,
  maxDepth = 3,
  spy = true,
  offsetIds = [],
  class: className,
} = Astro.props as TableOfContentsProps;

const tocNodes = buildToc(headings, { minDepth, maxDepth });

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderTocList(nodes: TocNode[], isNested = false): string {
  if (!nodes || nodes.length === 0) return '';
  const listClass = isNested ? 'toc__list toc__list--nested' : 'toc__list';
  let html = `<ol class="${listClass}" role="list">`;
  for (const node of nodes) {
    html += `<li class="toc__item" data-depth="${node.depth}">`;
    html += `<a href="#${encodeURIComponent(node.id)}" class="toc__link" data-toc-link>${escapeHtml(node.text)}</a>`;
    if (node.children && node.children.length > 0) {
      html += renderTocList(node.children, true);
    }
    html += '</li>';
  }
  html += '</ol>';
  return html;
}

const renderedListHtml = renderTocList(tocNodes);
---

{tocNodes.length > 0 && (
  <nav
    id={id}
    class:list={['toc', className]}
    aria-label={label}
    data-toc-spy={spy ? '' : undefined}
    data-content-id={contentId}
    data-offset-ids={offsetIds.length > 0 ? offsetIds.join(',') : undefined}
  >
    <p class="toc__title" id={`${id}-title`}>{label}</p>
    <Fragment set:html={renderedListHtml} />
  </nav>
)}

{spy && (
  <script>
    import { initToc } from '../lib/toc';
    if (typeof document !== 'undefined') {
      initToc(document);
    }
  </script>
)}

<style>
  @layer components {
    .toc {
      font-size: var(--text-step--1, 0.875rem);
      line-height: 1.4;
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing-content, 1.5rem) * 0.5);
    }

    .toc__title {
      font-weight: 600;
      color: var(--color-muted, currentColor);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.75rem;
      margin: 0;
    }

    .toc__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .toc__list--nested {
      padding-inline-start: 0.875rem;
      margin-inline-start: 0.125rem;
      border-inline-start: 1px solid var(--color-border, currentColor);
      gap: 0.2rem;
      margin-top: 0.25rem;
    }

    .toc__item {
      margin: 0;
      padding: 0;
    }

    .toc__link {
      display: block;
      padding: 0.15rem 0.5rem;
      color: var(--color-muted, currentColor);
      text-decoration: none;
      border-radius: var(--radius-control, 4px);
      border-inline-start: 2px solid transparent;
      transition: color var(--duration-fast, 120ms) ease,
                  background var(--duration-fast, 120ms) ease,
                  border-color var(--duration-fast, 120ms) ease;
    }

    .toc__link:hover {
      color: var(--color-text, currentColor);
      background: color-mix(in oklch, currentColor 5%, transparent);
    }

    .toc__link:focus-visible {
      outline: 2px solid var(--color-focus, currentColor);
      outline-offset: 1px;
    }

    .toc__link[aria-current="location"] {
      color: var(--color-link, #0969da);
      font-weight: 600;
      border-inline-start-color: var(--color-link, #0969da);
      background: color-mix(in oklch, var(--color-link, currentColor) 8%, transparent);
    }

    @media (forced-colors: active) {
      .toc__link[aria-current="location"] {
        color: Highlight !important;
        border-inline-start-color: Highlight !important;
      }
    }
  }
</style>
