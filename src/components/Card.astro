---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { publicLink } from '../lib/public-link';
import ResponsiveImage from './ResponsiveImage.astro';
import { mediaTransition, transitionName } from '../lib/view-transition';
// Attribute bags also accept CMS data-* annotations, without importing a CMS type.
type FieldAttributes = HTMLAttributes<'span'>;
interface Props extends Omit<HTMLAttributes<'article'>, 'title'> {
  title: string; href?: string; action?: string; description?: string;
  image?: ImageMetadata | string; imageAlt?: string;
  imageWidth?: number; imageHeight?: number;
  headingLevel?: 2 | 3 | 4; layout?: 'stacked' | 'horizontal';
  imageFit?: 'cover' | 'contain'; imageAspect?: string; sizes?: string;
  titleEdit?: FieldAttributes;
  descriptionEdit?: FieldAttributes;
  actionEdit?: FieldAttributes;
  /** Optional shared-element View Transition prefix; sets ident-safe `<prefix>-media` (with the `vt-media` class) and `<prefix>-title` view-transition-name. */
  transitionName?: string;
  class?: string;
}
const { title: rawTitle, href: rawHref, action: rawAction, description: rawDescription, image, imageAlt = '', imageWidth, imageHeight, headingLevel = 3,
  layout = 'stacked', imageFit: rawFit, imageAspect: rawAspect, sizes,
  titleEdit: rawTitleEdit, descriptionEdit: rawDescriptionEdit, actionEdit: rawActionEdit, transitionName: rawTransitionName, class: className, ...rest } = Astro.props;
const fieldAttributes = (value: unknown): FieldAttributes => value && typeof value === 'object' && !Array.isArray(value) ? value as FieldAttributes : {};
const titleEdit = fieldAttributes(rawTitleEdit), descriptionEdit = fieldAttributes(rawDescriptionEdit), actionEdit = fieldAttributes(rawActionEdit);
const imageFit = rawFit === 'contain' ? 'contain' : 'cover';
const imageAspect = typeof rawAspect === 'string' && rawAspect.trim() ? rawAspect : '3 / 2';
const transitionPrefix = typeof rawTransitionName === 'string' ? transitionName(rawTransitionName) : '';
const mediaStyle = [`--card-aspect: ${imageAspect}`, `--card-fit: ${imageFit}`, transitionPrefix && mediaTransition(rawTransitionName, 'media')].filter(Boolean).join('; ');
const titleAttrs = transitionPrefix ? { ...titleEdit, style: [titleEdit.style, `view-transition-name: ${transitionName(rawTransitionName, 'title')}`].filter(Boolean).join('; ') } : titleEdit;
const title = typeof rawTitle === 'string' ? rawTitle : '';
const description = typeof rawDescription === 'string' ? rawDescription : '';
const action = typeof rawAction === 'string' ? rawAction : '';
const href = publicLink(rawHref);
const Heading = `h${[2, 3, 4].includes(headingLevel) ? headingLevel : 3}` as 'h2' | 'h3' | 'h4';
const hasMedia = image || Astro.slots.has('media');
const hasTitleExtra = Astro.slots.has('title-extra');
const hasDescription = Boolean(description || Astro.slots.has('default') || Object.keys(descriptionEdit || {}).length);
---
<article data-editorial-island class:list={['card', { 'card--horizontal': layout === 'horizontal' && hasMedia, 'card--clickable': Boolean(href), 'focus-parent': Boolean(href) }, className]} {...rest}>
  <div class="card-layout">
  {hasMedia && <div class="card-media" style={mediaStyle}><slot name="media">{image && <ResponsiveImage src={image} alt={imageAlt} width={imageWidth} height={imageHeight} sizes={sizes} />}</slot></div>}
  <div class="card-body">
    {hasTitleExtra ? <div class="card-title-row"><Heading class="card-title" {...(titleAttrs || {})}>{href ? <a href={href} class="card-link clickable-parent">{title}</a> : title}</Heading><slot name="title-extra" /></div> : <Heading class="card-title" {...(titleAttrs || {})}>{href ? <a href={href} class="card-link clickable-parent">{title}</a> : title}</Heading>}
    {Astro.slots.has('metadata') && <div class="card-metadata"><slot name="metadata" /></div>}
    {hasDescription && <div class="card-description">{description && <p {...(descriptionEdit || {})}>{description}</p>}<slot /></div>}
    {action && <span class="card-action" {...(actionEdit || {})}>{action}<slot name="action-icon" /></span>}
  </div>
  </div>
</article>
<style>
@layer components {
.card {
  --card-bg: var(--color-surface);
  --card-text: var(--color-text);
  --card-muted: var(--color-muted);
  --card-border-width: 1px;
  --card-border-color: var(--color-border);
  --card-radius: var(--radius-card);
  --card-padding: var(--spacing-content);
  --card-frame-padding: 0px;
  --card-gap: var(--spacing-content);
  --card-shadow: none;
  /* A clickable card's media zooms this much on hover or keyboard focus; 1 turns it off. */
  --card-media-hover-scale: 1.03;
  --card-media-radius: max(0px, calc(var(--card-radius) - var(--card-frame-padding)));
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  padding: var(--card-frame-padding);
  border: var(--card-border-width) solid var(--card-border-color);
  border-radius: var(--card-radius);
  background: var(--card-bg);
  color: var(--card-text);
  box-shadow: var(--card-shadow);
  overflow: hidden;
  transition: border-color var(--duration-base, 200ms) var(--ease-smooth, ease), box-shadow var(--duration-base, 200ms) var(--ease-smooth, ease);
}
.card-link { color: inherit; text-decoration: none; }
@media (hover: hover) {
  .card-link:hover { text-decoration: none; }
}
.card-link::after { content: ""; position: absolute; inset: 0; z-index: var(--z-raised, 1); }
.card :global(a:not(.card-link), button, [data-emdash-field]) { position: relative; z-index: calc(var(--z-raised, 1) + 1); }
.card--clickable:focus-within:has(:focus-visible) { border-color: var(--color-action); }
.card--clickable:focus-within:has(:focus-visible) .card-action { text-decoration: underline; }
@media (hover: hover) and (pointer: fine) {
  .card--clickable:hover { border-color: var(--color-action); }
  .card--clickable:hover .card-action { text-decoration: underline; }
}
/* The media zoom is a composited scale inside the clipped media box: no layout moves. Pointer
   hover and keyboard focus share it, and it is off with reduced motion. */
@media (prefers-reduced-motion: no-preference) {
  .card--clickable .card-media :global(img) { transition: scale var(--duration-slower, 380ms) var(--ease-smooth, ease); }
  .card--clickable:focus-within:has(:focus-visible) .card-media :global(img) { scale: var(--card-media-hover-scale); }
}
@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
  .card--clickable:hover .card-media :global(img) { scale: var(--card-media-hover-scale); }
}
/* The layout wrapper adds no box for a stacked card: media and body stay flex children of the card. */
.card-layout { display: contents; }
.card-media { aspect-ratio: var(--card-aspect); border-radius: var(--card-media-radius); overflow: hidden; }
.card-media :global(img), .card-media :global(picture) { width: 100%; height: 100%; object-fit: var(--card-fit); display: block; }
.card-body { display: flex; flex: 1; flex-direction: column; gap: var(--card-gap); padding: var(--card-padding); min-width: 0; }
.card-title-row { display: flex; justify-content: space-between; align-items: center; gap: var(--card-gap); }
.card h2, .card h3, .card h4 { font-size: var(--text-step-0); overflow-wrap: anywhere; }
.card-metadata, .card-description { color: var(--card-muted); }
.card-action { margin-top: auto; font-weight: 700; color: var(--color-action); }
/* Narrow-first: a horizontal card is stacked by default and goes side by side only when the card
   itself is at least 32rem wide, wherever it is placed (a grid cell, a sidebar or a full-width
   feature). The card is its own named query container, so it measures its own inline size; give
   a horizontal card a definite width when it sits in a flex row. */
.card--horizontal { container: card / inline-size; }
@container card (min-width: 32rem) {
  .card--horizontal > .card-layout { display: grid; flex: 1; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
}
}
</style>
