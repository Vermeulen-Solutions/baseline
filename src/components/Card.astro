---
import { publicLink } from '../lib/public-link';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  title: string; href?: string; action?: string; image?: string; imageAlt?: string;
  headingLevel?: 2 | 3 | 4; layout?: 'stacked' | 'horizontal';
  imageFit?: 'cover' | 'contain'; imageAspect?: string; sizes?: string;
}
const { title, href, action, image, imageAlt = '', headingLevel = 3,
  layout = 'stacked', imageFit = 'cover', imageAspect = '3 / 2', sizes } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
if (href !== undefined && !publicLink(href)) throw new Error('Card href must use a supported public URL');
const hasMedia = image || Astro.slots.has('media');
---
<article class:list={['card', { 'card--horizontal': layout === 'horizontal' && hasMedia, 'card--clickable': Boolean(href), 'focus-parent': Boolean(href) }]}>
  {hasMedia && <div class="card-media" style={{'--card-aspect':imageAspect,'--card-fit':imageFit}}><slot name="media">{image && <ResponsiveImage src={image} alt={imageAlt} sizes={sizes} />}</slot></div>}
  <div class="card-body">
    <Heading class="card-title">{href ? <a href={href} class="card-link clickable-parent">{title}</a> : title}</Heading>
    {Astro.slots.has('metadata') && <div class="card-metadata"><slot name="metadata" /></div>}
    {Astro.slots.has('default') && <div class="card-description"><slot /></div>}
    {action && <span class="card-action">{action}</span>}
  </div>
</article>
<style>
.card {
  --card-bg: var(--color-surface);
  --card-text: var(--color-text);
  --card-muted: var(--color-muted);
  --card-border-width: 1px;
  --card-border-color: var(--color-border);
  --card-radius: var(--radius-card);
  --card-padding: var(--spacing-content);
  --card-frame-padding: 0px;
  --card-gap: var(--spacing-content);
  --card-shadow: none;
  --card-media-radius: max(0px, calc(var(--card-radius) - var(--card-frame-padding)));
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  padding: var(--card-frame-padding);
  border: var(--card-border-width) solid var(--card-border-color);
  border-radius: var(--card-radius);
  background: var(--card-bg);
  color: var(--card-text);
  box-shadow: var(--card-shadow);
  overflow: hidden;
  transition: border-color 0.2s var(--ease-smooth, ease), box-shadow 0.2s var(--ease-smooth, ease);
}
.card-link { color: inherit; text-decoration: none; }
.card-link:hover { text-decoration: none; }
.card-link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
.card :global(a:not(.card-link), button) { position: relative; z-index: 2; }
.card--clickable:focus-within:has(:focus-visible) { border-color: var(--color-action); }
.card--clickable:focus-within:has(:focus-visible) .card-action { text-decoration: underline; }
@media (hover: hover) and (pointer: fine) {
  .card--clickable:hover { border-color: var(--color-action); }
  .card--clickable:hover .card-action { text-decoration: underline; }
}
.card-media { aspect-ratio: var(--card-aspect); border-radius: var(--card-media-radius); overflow: hidden; }
.card-media :global(img), .card-media :global(picture) { width: 100%; height: 100%; object-fit: var(--card-fit); display: block; }
.card-body { display: flex; flex: 1; flex-direction: column; gap: var(--card-gap); padding: var(--card-padding); min-width: 0; }
.card h2, .card h3, .card h4 { font-size: var(--text-step-0); overflow-wrap: anywhere; }
.card-metadata, .card-description { color: var(--card-muted); }
.card-action { margin-top: auto; font-weight: 700; color: var(--color-action); }
.card--horizontal { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
@container (max-width: 32rem) { .card--horizontal { display: flex; } }
@media (max-width: 40rem) { .card--horizontal { display: flex; } }
</style>
