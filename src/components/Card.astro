---
import { publicLink } from '../lib/public-link';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  title: string; href: string; action?: string; image?: string; imageAlt?: string;
  headingLevel?: 2 | 3 | 4; layout?: 'stacked' | 'horizontal';
  imageFit?: 'cover' | 'contain'; imageAspect?: string; sizes?: string;
}
const { title, href, action, image, imageAlt = '', headingLevel = 3,
  layout = 'stacked', imageFit = 'cover', imageAspect = '3 / 2', sizes } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
if (!publicLink(href)) throw new Error('Card href must use a supported public URL');
const hasMedia = image || Astro.slots.has('media');
---
<a href={href} class:list={['card', { 'card--horizontal': layout === 'horizontal' && hasMedia }]}>
  {hasMedia && <div class="card-media" style={{'--card-aspect':imageAspect,'--card-fit':imageFit}}><slot name="media">{image && <ResponsiveImage src={image} alt={imageAlt} sizes={sizes} />}</slot></div>}
  <div class="card-body">
    <Heading>{title}</Heading>
    {Astro.slots.has('metadata') && <div class="card-metadata"><slot name="metadata" /></div>}
    {Astro.slots.has('default') && <div class="card-description"><slot /></div>}
    {action && <span class="card-action">{action}</span>}
  </div>
</a>
<style>
.card { display:flex; flex-direction:column; min-width:0; height:100%; border:1px solid var(--color-border); border-radius:var(--radius-card); background:var(--color-surface); color:var(--color-text); text-decoration:none; overflow:hidden; }
.card:is(:hover,:focus-visible) { border-color:var(--color-action); }
.card-media { aspect-ratio:var(--card-aspect); overflow:hidden; }
.card-media :global(img), .card-media :global(picture) { width:100%; height:100%; object-fit:var(--card-fit); display:block; }
.card-body { display:flex; flex:1; flex-direction:column; gap:var(--spacing-content); padding:var(--spacing-content); min-width:0; }
.card h2,.card h3,.card h4 { font-size:var(--text-step-0); overflow-wrap:anywhere; }
.card-metadata,.card-description { color:var(--color-muted); }
.card-action { margin-top:auto; font-weight:700; color:var(--color-action); }
.card:is(:hover,:focus-visible) .card-action { text-decoration:underline; }
.card--horizontal { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); }
@media (max-width:40rem) { .card--horizontal { display:flex; } }
</style>
