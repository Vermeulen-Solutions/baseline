---
import { tokenGroups, stylesheetDigest } from '../utils/design-tweaks.mjs';
import sourceCSS from '../styles/global.css?raw';
// Authored fallback keeps unused Tailwind tokens inspectable without changing public CSS.
const sourceTokens = new Map<string, string>();
for (const match of sourceCSS.matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)) {
  if (!sourceTokens.has(match[1])) sourceTokens.set(match[1], match[2].trim());
}
// Digest of the authored stylesheet, so a calibration receipt can be tied to exact bytes.
const sourceHash = await stylesheetDigest(sourceCSS);
/**
 * TweaksBar: In-browser live design token inspector and visual calibration tool.
 * Only rendered in development mode (import.meta.env.DEV).
 */
---

<aside id="tweaks-panel" aria-label="Design Tweaks" class="tweaks-drawer tweaks-closed" data-source-hash={sourceHash}>
	<button id="tweaks-toggle-btn" class="tweaks-tab-handle" aria-expanded="false" aria-controls="tweaks-content" title="Toggle Live Design Controls (Press 'T')">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="3"></circle>
			<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
		</svg>
		<span>Tweaks</span>
	</button>

	<div id="tweaks-content" class="tweaks-content" inert>
		<header class="tweaks-header">
			<div>
				<h3 class="tweaks-title">Design Tweaks</h3>
				<span class="tweaks-sub">Live token inspector</span>
			</div>
			<div class="tweaks-header-actions">
				<button id="tweaks-compare-btn" class="tweaks-mini-btn" aria-pressed="false" title="Toggle stylesheet baseline (Key: B)">Compare</button>
				<button id="tweaks-reset-btn" class="tweaks-mini-btn" title="Remove all preview overrides">Reset</button>
			</div>
		</header>


    <div class="tweaks-discovery">
      <label for="tweaks-search">Find a setting or CSS token</label>
      <input id="tweaks-search" type="search" placeholder="Search tokens and tools…" autocomplete="off" />
      <nav class="tweaks-categories" aria-label="Setting categories">
        {[['all', 'All'], ...tokenGroups.map(group => [group.id, group.label]), ['inspect', 'Inspect']].map(([id, label]) => (
          <button type="button" class="tweaks-mini-btn" data-category={id} aria-pressed={id === 'all' ? 'true' : 'false'}>{label}</button>
        ))}
      </nav>
      <p id="tweaks-preview-status" role="status">Source styles · no overrides</p>
    </div>
    <div class="tweaks-body" id="tweaks-settings">
      <p id="tweaks-no-results" class="tweaks-note" hidden>No matching settings. Try another term or choose All.</p>
      <fieldset class="tweaks-group" data-setting-category="typography">
				<legend>Typography</legend>
				<div class="tweaks-slider-row">
					<label for="tweak-type-scale">Heading Scale <span id="val-type-scale">1.0x</span></label>
					<input type="range" id="tweak-type-scale" min="0.8" max="1.4" step="0.05" value="1.0" />
				</div>
				<div class="tweaks-slider-row">
					<label for="tweak-type-weight">Header Weight <span id="val-type-weight">700</span></label>
					<input type="range" id="tweak-type-weight" min="100" max="900" step="100" value="700" />
				</div>
				<div class="tweaks-slider-row">
					<label for="tweak-tracking">Letter Spacing <span id="val-tracking">0.00em</span></label>
					<input type="range" id="tweak-tracking" min="-0.04" max="0.1" step="0.005" value="0.0" />
				</div>
			</fieldset>
      <fieldset class="tweaks-group" data-setting-category="spacing"><legend>Spatial density</legend><div class="tweaks-slider-row">
					<label for="tweak-density-scale">Spatial Density <span id="val-density-scale">1.0x</span></label>
					<input type="range" id="tweak-density-scale" min="0.75" max="1.35" step="0.05" value="1.0" />
				</div>
				</fieldset>
      {tokenGroups.map(group => (
        <fieldset class="tweaks-group" data-setting-category={group.id}>
          <legend>{group.label} tokens</legend>
          <p class="tweaks-note">{group.help}</p>
          {group.tokens.map(([key, label, property, readonly]) => {
            const id = key.slice(2);
            const inputId = property === 'color' ? 'tweak-' + id : 'tweak-token-' + id;
            return (
              <div class="tweaks-token" data-token-row={key}>
                <div class="tweaks-token-heading">
                  <label for={inputId}>{label}</label>
                  {!readonly && <button type="button" class="tweaks-mini-btn" data-reset-token={key} aria-label={'Reset ' + key} disabled>Reset</button>}
                </div>
                <code>{key}</code>
                <div class="tweaks-token-value">
                  {property === 'color' && <span class="tweaks-swatch" data-swatch={key} aria-hidden="true"></span>}
                  <input id={inputId} type="text" data-token={key} data-property={property} data-source={sourceTokens.get(key) ?? ''} data-color-token={property === 'color' ? key : undefined} readonly={!!readonly} spellcheck="false" aria-describedby={'source-' + id + ' error-' + id} />
                </div>
                <details class="tweaks-token-source"><summary>Source value</summary><code id={'source-' + id}></code></details>
                <p id={'error-' + id} class="tweaks-error" hidden>Enter a valid {property} value to preview and export.</p>
              </div>
            );
          })}
        </fieldset>
      ))}
      <fieldset class="tweaks-group" data-setting-category="effects">
				<legend>Surface Pattern</legend>
				<div class="tweaks-pill-selector">
					<label><input type="radio" name="tweak-surface" value="baseline" checked /> <span>Source</span></label>
					<label><input type="radio" name="tweak-surface" value="solid" /> <span>Solid</span></label>
					<label><input type="radio" name="tweak-surface" value="grid" /> <span>Grid</span></label>
					<label><input type="radio" name="tweak-surface" value="dots" /> <span>Dots</span></label>
					<label><input type="radio" name="tweak-surface" value="noise" /> <span>Grain</span></label>
				</div>
			</fieldset>
      <fieldset class="tweaks-group" data-setting-category="effects">
				<legend>Hero Asset Treatment</legend>
				<div class="tweaks-slider-row">
					<label for="tweak-hero-brightness">Brightness <span id="val-hero-brightness">100%</span></label>
					<input type="range" id="tweak-hero-brightness" min="40" max="140" step="5" value="100" />
				</div>
				<div class="tweaks-slider-row">
					<label for="tweak-hero-contrast">Contrast <span id="val-hero-contrast">100%</span></label>
					<input type="range" id="tweak-hero-contrast" min="60" max="150" step="5" value="100" />
				</div>
				<div class="tweaks-slider-row">
					<label for="tweak-hero-saturation">Saturation <span id="val-hero-saturation">100%</span></label>
					<input type="range" id="tweak-hero-saturation" min="0" max="160" step="5" value="100" />
				</div>
			</fieldset>
      <fieldset class="tweaks-group" data-setting-category="inspect">
				<legend>Layout Guide</legend>
				<button id="tweaks-grid-btn" type="button" class="tweaks-mini-btn" aria-pressed="false" title="Toggle layout guide while panel is open (G)">Grid guide (G)</button>
				<div class="tweaks-color-row"><label for="tweaks-grid-target">Container</label><select id="tweaks-grid-target"></select></div>
				<div class="tweaks-color-row"><label for="tweaks-grid-columns">Columns</label><select id="tweaks-grid-columns"><option value="12">12 columns</option><option value="10">10 columns</option></select></div>
				<p id="tweaks-grid-status" role="status">Guide off. No source styles changed.</p>
			</fieldset>
<fieldset class="tweaks-group" data-setting-category="inspect" id="tweaks-reference-drop">
				<legend>Reference overlay</legend>
				<button id="tweaks-reference-btn" type="button" class="tweaks-mini-btn" aria-pressed="false">Reference overlay (O)</button>
				<label for="tweaks-reference-file">Choose or drop one local raster (10 MiB / 32 MP maximum)</label>
				<input id="tweaks-reference-file" type="file" accept="image/png,image/jpeg,image/webp" />
				<div class="tweaks-color-row"><label for="tweaks-reference-mode">Comparison</label><select id="tweaks-reference-mode"><option value="document">Full document (scrolls)</option><option value="viewport">Fixed viewport</option></select></div>
				<div class="tweaks-slider-row"><label for="tweaks-reference-opacity">Opacity</label><input id="tweaks-reference-opacity" type="range" min="0" max="1" step=".05" value=".5" /></div>
				<div class="tweaks-color-row"><label for="tweaks-reference-x">X offset (CSS px)</label><input id="tweaks-reference-x" type="number" value="0" min="-100000" max="100000" /></div>
				<div class="tweaks-color-row"><label for="tweaks-reference-y">Y offset (CSS px)</label><input id="tweaks-reference-y" type="number" value="0" min="-100000" max="100000" /></div>
				<div class="tweaks-color-row"><label for="tweaks-reference-dpr">Reference capture DPR</label><input id="tweaks-reference-dpr" type="number" min=".25" max="8" step=".25" value="1" /></div>
				<div class="tweaks-color-row"><label for="tweaks-reference-scale">Explicit image scale</label><input id="tweaks-reference-scale" type="number" min=".1" max="4" step=".1" value="1" /></div>
				<div id="tweaks-reference-alignment" class="tweaks-alignment" tabindex="0" role="group" aria-label="Reference alignment: arrow keys move 1 CSS pixel; Shift moves 10">Focus here to align with arrow keys (Shift: 10px).</div>
				<button id="tweaks-reference-reset" type="button" class="tweaks-mini-btn">Reset alignment</button>
				<button id="tweaks-reference-clear" type="button" class="tweaks-mini-btn">Clear reference</button>
				<p id="tweaks-reference-status" role="status"></p>
				<p class="tweaks-note">Local memory only. No upload, remote URL, storage or numerical diff. Closing the drawer clears the file.</p>
			</fieldset>
<fieldset class="tweaks-group" data-setting-category="inspect">
				<legend>EmDash ownership</legend>
				<button id="tweaks-ownership-btn" type="button" class="tweaks-mini-btn" aria-pressed="false">Ownership inspector (P)</button>
				<label for="tweaks-ownership-target">Observed annotation</label><select id="tweaks-ownership-target"></select>
				<p class="tweaks-note">Solid green: field; blue: entry context. Dashed amber: unknown; magenta: unsupported.</p>
				<p id="tweaks-ownership-status" role="status"></p><p id="tweaks-ownership-details"></p>
			</fieldset>
    </div>

		<footer class="tweaks-footer">
			<button id="tweaks-close-btn" class="tweaks-mini-btn tweaks-mobile-close">Close controls</button>
			<button id="tweaks-export-btn" class="tweaks-primary-btn">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
				Copy Tokens (CSS)
			</button>
			<button id="tweaks-receipt-btn" class="tweaks-mini-btn">Copy Receipt (JSON)</button>
			<textarea id="tweaks-export-fallback" aria-label="Exported CSS or receipt; select and copy" readonly hidden></textarea>
			<span id="tweaks-export-feedback" class="tweaks-feedback" aria-live="polite"></span>
		</footer>
	</div>
</aside>

<style>
	.tweaks-alignment { padding: .6rem; border: 1px dashed #a1a1aa; border-radius: 4px; }
	.tweaks-alignment:focus-visible { outline: 2px solid #f4f4f5; outline-offset: 2px; }
	.tweaks-group input[type="file"], .tweaks-group select { max-inline-size: 100%; }
	.tweaks-group > label { display: block; margin-block-start: .5rem; }
	.tweaks-group > select, .tweaks-group > input[type="file"] { inline-size: 100%; }
	.tweaks-group input[type="number"], .tweaks-group select { min-inline-size: 0; color: #f4f4f5; background: #27272a; border: 1px solid #71717a; border-radius: 4px; padding: 5px; font-size: 12px; }
	.tweaks-color-row input[type="number"] { inline-size: 90px; flex-shrink: 0; }
	.tweaks-color-row label { min-inline-size: 0; padding-inline-end: 6px; }
	.tweaks-mini-btn { min-block-size: 28px; }
	#tweaks-ownership-details, #tweaks-ownership-status, #tweaks-reference-status { overflow-wrap: anywhere; }
	@media (max-width: 60rem) {
		:global(body:has(#emdash-toolbar:not([hidden]))) .tweaks-drawer { bottom: 6rem; }
	}
	.tweaks-drawer {
		position: fixed;
		top: 1rem;
		right: 1rem;
		bottom: 1rem;
		width: 380px;
		max-width: calc(100vw - 2rem);
		background: #18181b;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 12px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 0, 0, 0.4);
		color: #e4e4e7;
		font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
		font-size: 12px;
		z-index: 999999;
		display: flex;
		flex-direction: column;
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
	}
	.tweaks-drawer.tweaks-closed {
		transform: translateX(calc(100% + 1rem));
		pointer-events: none;
	}
	.tweaks-tab-handle {
		position: absolute;
		left: -84px;
		top: 1.5rem;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 6px 10px;
		background: rgba(18, 18, 22, 0.92);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 8px 0 0 8px;
		color: #f4f4f5;
		font-weight: 600;
		font-size: 11.5px;
		cursor: pointer;
		box-shadow: -4px 6px 16px rgba(0, 0, 0, 0.3);
		pointer-events: auto;
	}
	.tweaks-content {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
	}
	.tweaks-mobile-close { display: none; }
	@media (max-width: 420px) {
		.tweaks-drawer:not(.tweaks-closed) .tweaks-tab-handle { visibility: hidden; }
		.tweaks-mobile-close { display: block; }
	}
	.tweaks-closed .tweaks-content { visibility: hidden; }
	.tweaks-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 12px 14px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.tweaks-title {
		font-family: inherit; letter-spacing: normal; line-height: 1.3;
		margin: 0;
		font-size: 13px;
		font-weight: 700;
	}
	.tweaks-sub {
		font-size: 11px;
		color: #a1a1aa;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.tweaks-mini-btn {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #d4d4d8;
		border-radius: 4px;
		padding: 3px 8px;
		font-size: 11px;
		cursor: pointer;
	}
	.tweaks-mini-btn:hover {
		background: rgba(255, 255, 255, 0.16);
		color: #fff;
	}
	.tweaks-body {
		flex: 1;
		overflow-y: auto;
		padding: 12px 14px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.tweaks-group {
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.02);
		border-radius: 8px;
		padding: 8px 10px;
		margin: 0;
	}
	.tweaks-group legend {
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: #a1a1aa;
		padding: 0 4px;
	}
	.tweaks-pill-selector {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 4px;
		margin-top: 4px;
	}
	.tweaks-pill-selector label {
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.tweaks-pill-selector input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}
	.tweaks-pill-selector input:focus-visible + span { outline: 2px solid #93c5fd; }
	.tweaks-pill-selector span {
		display: block;
		width: 100%;
		text-align: center;
		padding: 4px 2px;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid transparent;
		font-size: 10px;
		transition: background-color 0.15s ease;
	}
	.tweaks-pill-selector input:checked + span {
		background: rgba(255, 255, 255, 0.22);
		border-color: rgba(255, 255, 255, 0.3);
		color: #fff;
		font-weight: 600;
	}
	.tweaks-slider-row {
		display: flex;
		flex-direction: column;
		gap: 3px;
		margin-top: 8px;
	}
	.tweaks-slider-row label {
		display: flex;
		justify-content: space-between;
		font-size: 11px;
		color: #d4d4d8;
	}
	.tweaks-slider-row label span {
		color: #a1a1aa;
		font-family: ui-monospace, monospace;
		font-size: 10px;
	}
	.tweaks-slider-row input[type="range"] {
		width: 100%;
		accent-color: #3b82f6;
		height: 4px;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.15);
		cursor: pointer;
	}
	.tweaks-color-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 8px;
	}
	.tweaks-color-row input[type="text"] { width: 145px; min-width: 0; color: #f4f4f5; background: #27272a; border: 1px solid #71717a; border-radius: 4px; padding: 5px; font-size: 11px; }
	.tweaks-color-row input[aria-invalid="true"] { border-color: #fca5a5; }
	.tweaks-note { font-size: 11px; line-height: 1.5; color: #d4d4d8; }
	#tweaks-export-fallback { width: 100%; height: 100px; color: #f4f4f5; background: #27272a; }
	.tweaks-footer {
		padding: 10px 14px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.tweaks-primary-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		width: 100%;
		padding: 7px;
		background: #2563eb;
		color: #fff;
		border: none;
		border-radius: 6px;
		font-weight: 600;
		font-size: 11px;
		cursor: pointer;
	}
	.tweaks-primary-btn:hover {
		background: #1d4ed8;
	}
	.tweaks-feedback {
		font-size: 10px;
		color: #4ade80;
		text-align: center;
		min-height: 14px;
	}

  .tweaks-drawer { color-scheme: dark; line-height: 1.5; }
  .tweaks-drawer :is(button, input, select, textarea) { font-family: inherit; }
  .tweaks-drawer :is(button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid #93c5fd; outline-offset: 3px; }
  .tweaks-drawer [hidden] { display: none !important; }
  .tweaks-header { gap: 12px; flex-wrap: wrap; }
  .tweaks-header-actions { display: flex; gap: 6px; }
  .tweaks-sub { text-transform: none; letter-spacing: normal; }
  .tweaks-mini-btn { min-block-size: 32px; }
  .tweaks-mini-btn[aria-pressed="true"] { background: #1e3a5f; border-color: #93c5fd; color: #eff6ff; }
  .tweaks-discovery { padding: 12px 14px; border-bottom: 1px solid #3f3f46; }
  .tweaks-discovery > label { display: block; margin-bottom: 6px; color: #d4d4d8; }
  #tweaks-search { inline-size: 100%; padding: 8px; background: #27272a; border: 1px solid #71717a; border-radius: 4px; color: #fafafa; font-size: 13px; }
  #tweaks-search::placeholder { color: #a1a1aa; }
  .tweaks-categories { display: flex; flex-wrap: wrap; gap: 5px; margin-block: 10px; }
  #tweaks-preview-status { color: #bfdbfe; font-size: 12px; }
  .tweaks-body { overscroll-behavior: contain; min-block-size: 0; gap: 20px; }
  .tweaks-group { flex-shrink: 0; min-inline-size: 0; padding: 8px 10px 12px; }
  .tweaks-group legend { text-transform: none; letter-spacing: normal; color: #e4e4e7; font-size: 13px; }
  .tweaks-token { padding-block: 12px; border-bottom: 1px solid #3f3f46; }
  .tweaks-token:last-child { border-bottom: none; padding-bottom: 0; }
  .tweaks-token-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .tweaks-token-heading label { font-size: 13px; font-weight: 600; }
  .tweaks-token code { display: block; overflow-wrap: anywhere; color: #a1a1aa; font-size: 11px; font-family: ui-monospace, monospace; }
  .tweaks-token-value { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
  .tweaks-token input { inline-size: 100%; min-inline-size: 0; padding: 8px; color: #fafafa; background: #27272a; border: 1px solid #71717a; border-radius: 4px; font-size: 12px; }
  .tweaks-token input[readonly] { border-style: dashed; color: #d4d4d8; }
  .tweaks-token input[aria-invalid="true"] { border-color: #fca5a5; }
  .tweaks-token[data-modified="true"] > code { color: #bfdbfe; }
  .tweaks-token-source { margin-top: 6px; font-size: 11px; }
  .tweaks-token-source summary { cursor: pointer; color: #d4d4d8; }
  .tweaks-token-source code { margin-top: 4px; white-space: pre-wrap; }
  .tweaks-swatch { flex: 0 0 26px; block-size: 26px; border: 1px solid #a1a1aa; border-radius: 4px; }
  .tweaks-error { margin-top: 6px; font-size: 12px; color: #fca5a5; }
  .tweaks-primary-btn { min-block-size: 36px; font-size: 12px; }
  .tweaks-feedback { color: #d4d4d8; }
  .tweaks-footer { max-block-size: 35%; overflow-y: auto; }
  @media (max-width: 480px) {
    .tweaks-drawer { width: 300px; max-width: calc(100vw - 4rem); }
    .tweaks-drawer:not(.tweaks-closed) .tweaks-tab-handle { visibility: hidden; }
    .tweaks-mobile-close { display: block; }
    .tweaks-discovery { padding-block: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .tweaks-drawer { transition: none; } }
</style>

<script>
  import { baselineTokens, createTokenMap, exportTokens, buildReceipt } from '../utils/design-tweaks.mjs';
  import { copyText } from '../utils/clipboard.mjs';
  import { createGridGuide } from '../utils/grid-guide';
  import { createReferenceOverlay } from '../utils/reference-overlay';
  import { createOwnershipInspector } from '../utils/ownership-inspector';

  // Processed Astro scripts can be bundled even when a component is not rendered.
  // This compile-time guard lets production builds remove the controls' code.
  if (import.meta.env.DEV) {
  function initTweaksPanel() {
    const drawer = document.getElementById('tweaks-panel');
    if (!drawer || drawer.dataset.initialized) return;
    drawer.dataset.initialized = 'true';
    const root = document.documentElement;
    const content = document.getElementById('tweaks-content')!;
    const toggle = document.getElementById('tweaks-toggle-btn')!;
    const compare = document.getElementById('tweaks-compare-btn')!;
    const feedback = document.getElementById('tweaks-export-feedback')!;
    const fallback = document.getElementById('tweaks-export-fallback') as HTMLTextAreaElement;
    const computed = getComputedStyle(root);
    const heading = document.querySelector('h1, h2');
    const headingStyle = heading ? getComputedStyle(heading) : computed;
    const baseline: Record<string, string> = Object.fromEntries(baselineTokens.map(key => [key, computed.getPropertyValue(key).trim()]));
    const tokenInputs = [...drawer.querySelectorAll<HTMLInputElement>('[data-token]')];
    for (const input of tokenInputs) baseline[input.dataset.token!] ||= input.dataset.source || '';
    baseline['--font-weight-display'] ||= headingStyle.fontWeight;
    baseline['--letter-spacing-display'] ||= headingStyle.letterSpacing;
    baseline['--hero-filter'] ||= 'none';
    const inline = Object.fromEntries(baselineTokens.map(key => [key, { value: root.style.getPropertyValue(key), priority: root.style.getPropertyPriority(key) }]));
    let changes: Record<string, string> = {};
    let comparing = false;
    const controller = new AbortController();
    const options = { signal: controller.signal };
    const grid = createGridGuide(drawer, controller.signal);
    const reference = createReferenceOverlay(drawer, controller.signal, () => remember('o'));
    const ownership = createOwnershipInspector(drawer, controller.signal, import.meta.env.STARTER_EMDASH_VERSION);
    const tools = {g:grid, o:reference, p:ownership};
    const recent: (keyof typeof tools)[] = [];
    const remember = (key: keyof typeof tools) => { const i = recent.indexOf(key); if (i >= 0) recent.splice(i,1); if (tools[key].active) recent.push(key); };
    for (const [key,id] of [['g','grid'],['o','reference'],['p','ownership']] as const) drawer.querySelector(`#tweaks-${id}-btn`)!.addEventListener('click',()=>remember(key),options);

    function restore() {
      for (const [key, original] of Object.entries(inline)) {
        if (original.value) root.style.setProperty(key, original.value, original.priority);
        else root.style.removeProperty(key);
      }
    }
    function render() {
      restore();
      const tokens = createTokenMap(baseline, changes);
      if (!comparing) for (const [key, value] of Object.entries(tokens)) root.style.setProperty(key, String(value));
      const count = Object.keys(tokens).length;
      document.getElementById('tweaks-preview-status')!.textContent = comparing ? 'Showing source · preview paused' : count ? count + ' token override' + (count === 1 ? '' : 's') + ' · live preview' : 'Source styles · no overrides';
      for (const input of tokenInputs) {
        const key = input.dataset.token!;
        const row = input.closest<HTMLElement>('[data-token-row]')!;
        row.dataset.modified = String(key in tokens);
        const reset = row.querySelector<HTMLButtonElement>('[data-reset-token]');
        if (reset) reset.disabled = !(key in tokens) && input.getAttribute('aria-invalid') !== 'true';
        const swatch = row.querySelector<HTMLElement>('[data-swatch]');
        if (swatch) swatch.style.backgroundColor = String(comparing ? baseline[key] : tokens[key] ?? baseline[key]);
        if (document.activeElement !== input && input.getAttribute('aria-invalid') !== 'true') input.value = String(tokens[key] ?? baseline[key]);
      }
      compare.setAttribute('aria-pressed', String(comparing));
      compare.textContent = comparing ? 'Baseline' : 'Compare';
      fallback.hidden = true;
      grid.refresh();
    }
    function setOpen(open: boolean) {
      const returnFocus = !open && content.contains(document.activeElement);
      drawer!.classList.toggle('tweaks-closed', !open);
      content.inert = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) compare.focus();
      if (returnFocus) toggle.focus();
      if (!open) { grid.hide(); reference.clear(); ownership.hide(); recent.length = 0; comparing = false; render(); }
    }
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'), options);
    document.getElementById('tweaks-close-btn')!.addEventListener('click', () => setOpen(false), options);
    compare.addEventListener('click', () => { comparing = !comparing; render(); }, options);
    window.addEventListener('keydown', event => {
      if (event.defaultPrevented || event.repeat || event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return;
      if (event.composedPath().some(target => target instanceof HTMLElement && (target.isContentEditable || target.matches('input, textarea, select, dialog, [role="textbox"], [role="dialog"], [aria-modal="true"]')))) return;
      if ([...document.querySelectorAll<HTMLElement>('dialog[open], [aria-modal="true"], #emdash-toolbar[data-edit-mode="true"]')].some(element => !element.hidden && element.getClientRects().length)) return;
      if (event.key.toLowerCase() === 't') { event.preventDefault(); setOpen(toggle.getAttribute('aria-expanded') !== 'true'); }
      if (event.key.toLowerCase() === 'b' && toggle.getAttribute('aria-expanded') === 'true') { event.preventDefault(); comparing = !comparing; render(); }
      const key = event.key.toLowerCase();
      if ((key === 'g' || key === 'o' || key === 'p') && toggle.getAttribute('aria-expanded') === 'true') { event.preventDefault(); tools[key].toggle(); remember(key); }
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        event.preventDefault(); const last = [...recent].reverse().find(key=>tools[key].active) ?? (['p','o','g'] as const).find(key=>tools[key].active);
        if (last) { tools[last].hide(); remember(last); } else setOpen(false);
      }
    }, options);

    const sliders: [string, string, string, string, string][] = [
      ['type-scale', 'typeScale', 'type-scale', '1', 'x'],
      ['type-weight', 'typeWeight', 'type-weight', baseline['--font-weight-display'], ''],
      ['tracking', 'tracking', 'tracking', String((parseFloat(headingStyle.letterSpacing) || 0) / (parseFloat(headingStyle.fontSize) || 16)), 'em'],
      ['hero-brightness', 'heroBrightness', 'hero-brightness', '100', '%'],
      ['hero-contrast', 'heroContrast', 'hero-contrast', '100', '%'],
      ['hero-saturation', 'heroSaturation', 'hero-saturation', '100', '%'],
      ['density-scale', 'densityScale', 'density-scale', '1', 'x'],
    ];
    function syncInputs() {
      for (const [id, key, label, value, unit] of sliders) {
        const input = document.getElementById('tweak-' + id) as HTMLInputElement;
        input.value = changes[key] ?? value;
        document.getElementById('val-' + label)!.textContent = (changes[key] ?? value) + unit;
      }
      drawer!.querySelectorAll<HTMLInputElement>('[data-token]').forEach(input => {
        input.value = changes[input.dataset.token!] ?? baseline[input.dataset.token!];
        input.removeAttribute('aria-invalid');
        document.getElementById('source-' + input.dataset.token!.slice(2))!.textContent = baseline[input.dataset.token!] || 'Not defined in source';
        document.getElementById('error-' + input.dataset.token!.slice(2))!.hidden = true;
      });
      drawer!.querySelectorAll<HTMLInputElement>('[name="tweak-surface"]').forEach(input => { input.checked = input.value === (changes.surface ?? 'baseline'); });
    }
    for (const [id, key, label, , unit] of sliders) {
      const input = document.getElementById('tweak-' + id) as HTMLInputElement;
      input.addEventListener('input', () => {
        changes[key] = input.value;
        comparing = false;
        document.getElementById('val-' + label)!.textContent = input.value + unit;
        render();
      }, options);
    }
    for (const input of tokenInputs) {
      input.addEventListener('input', () => {
        if (input.readOnly) return;
        const valid = CSS.supports(input.dataset.property!, input.value) && !/[;{}]/.test(input.value);
        input.setAttribute('aria-invalid', String(!valid));
        document.getElementById('error-' + input.dataset.token!.slice(2))!.hidden = valid;
        if (valid) { changes[input.dataset.token!] = input.value; comparing = false; }
        render();
      }, options);
    }
    drawer.querySelectorAll<HTMLButtonElement>('[data-reset-token]').forEach(button => {
      button.addEventListener('click', () => {
        const key = button.dataset.resetToken!;
        // Source beats an active family scale for this token until global Reset.
        changes[key] = baseline[key]; comparing = false;
        const input = tokenInputs.find(input => input.dataset.token === key)!;
        input.removeAttribute('aria-invalid'); input.value = baseline[key];
        document.getElementById('error-' + key.slice(2))!.hidden = true;
        render();
        input.focus();
      }, options);
    });
    const search = document.getElementById('tweaks-search') as HTMLInputElement;
    let category = 'all';
    function filterSettings() {
      const query = search.value.trim().toLocaleLowerCase();
      let visible = 0;
      drawer!.querySelectorAll<HTMLElement>('[data-setting-category]').forEach(group => {
        const inCategory = category === 'all' || category === group.dataset.settingCategory;
        const rows = [...group.querySelectorAll<HTMLElement>('[data-token-row]')];
        const groupMatch = (group.querySelector('legend')?.textContent || '').toLocaleLowerCase().includes(query);
        for (const row of rows) row.hidden = !inCategory || !(groupMatch || (row.textContent || '').toLocaleLowerCase().includes(query));
        group.hidden = !inCategory || (rows.length ? rows.every(row => row.hidden) : !(group.textContent || '').toLocaleLowerCase().includes(query));
        if (!group.hidden) visible++;
      });
      document.getElementById('tweaks-no-results')!.hidden = !!visible;
      document.getElementById('tweaks-settings')!.scrollTop = 0;
    }
    search.addEventListener('input', filterSettings, options);
    drawer.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(button => {
      button.addEventListener('click', () => {
        category = button.dataset.category!;
        drawer!.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        filterSettings();
      }, options);
    });
    drawer.querySelectorAll<HTMLInputElement>('[name="tweak-surface"]').forEach(input => {
      input.addEventListener('change', () => { changes.surface = input.value; comparing = false; render(); }, options);
    });
    document.getElementById('tweaks-reset-btn')!.addEventListener('click', () => {
      changes = {}; comparing = false; grid.hide(); reference.clear(); ownership.hide(); recent.length = 0; syncInputs(); render(); feedback.textContent = 'Source styles restored.';
    }, options);
    document.getElementById('tweaks-export-btn')!.addEventListener('click', async () => {
      if (drawer!.querySelector('[aria-invalid="true"]')) { feedback.textContent = 'Fix invalid token values before exporting (search or choose All to find them).'; return; }
      const tokens = createTokenMap(baseline, changes);
      if (!Object.keys(tokens).length) { feedback.textContent = 'No overrides to export.'; return; }
      const css = exportTokens(tokens);
      if (await copyText(css) === 'manual') { fallback.value = css; fallback.hidden = false; fallback.focus(); fallback.select(); feedback.textContent = 'Select and copy the CSS below.'; }
      else feedback.textContent = 'Copied. Merge, reload, and verify contrast.';
    }, options);
    document.getElementById('tweaks-receipt-btn')!.addEventListener('click', async () => {
      if (drawer!.querySelector('[aria-invalid="true"]')) { feedback.textContent = 'Fix invalid token values before exporting (search or choose All to find them).'; return; }
      const tokens = createTokenMap(baseline, changes);
      if (!Object.keys(tokens).length) { feedback.textContent = 'No overrides to record.'; return; }
      const receipt = buildReceipt({
        tokens,
        baseline,
        globalCssSha256: drawer!.dataset.sourceHash ?? '',
        exportedAt: new Date().toISOString(),
      });
      if (await copyText(receipt) === 'manual') { fallback.value = receipt; fallback.hidden = false; fallback.focus(); fallback.select(); feedback.textContent = 'Select and copy the receipt below.'; }
      else feedback.textContent = 'Receipt copied. Save it under audit/ and check it with npm run check:token-calibration.';
    }, options);
    syncInputs();
    render();
    // Astro navigation must not retain old root overrides or global handlers.
    const teardown = () => { setOpen(false); restore(); controller.abort(); delete drawer!.dataset.initialized; };
    document.addEventListener('astro:before-swap', teardown, { once: true, signal: controller.signal });
    window.addEventListener('pagehide', teardown, { once: true, signal: controller.signal });
  }
  initTweaksPanel();
  document.addEventListener('astro:page-load', initTweaksPanel);
  window.addEventListener('pageshow', event => { if (event.persisted) initTweaksPanel(); });
  }
</script>
