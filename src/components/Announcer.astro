---
export interface Props {
  id?: string;
}

const { id = 'site-announcer' } = Astro.props as Props;
---

<div id={id} class="site-announcer sr-only" aria-hidden="false">
  <div data-announcer-polite aria-live="polite" aria-atomic="true"></div>
  <div data-announcer-assertive aria-live="assertive" aria-atomic="true"></div>
</div>

<style>
  @layer components {
    .site-announcer.sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  }
</style>
