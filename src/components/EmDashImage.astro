---
import ResponsiveImage from './ResponsiveImage.astro';
import { responsiveImageInput, type ResponsiveImageProps } from '../lib/responsive-image';
import { imageSource } from '../lib/image-source';

interface Props extends Omit<ResponsiveImageProps, 'src'> { src: string; }
const { src, alt, width, height, ...presentation } = Astro.props;
const input = responsiveImageInput(src, width, height);
const image = input.original ? await imageSource(input.original, Astro.url.origin, Astro.locals.emdash?.storage, input.width, input.height) : input;
---
<ResponsiveImage {...presentation} alt={alt} src={image.src} originalSrc={input.original} width={image.width} height={image.height} />
