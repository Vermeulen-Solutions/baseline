---
import ResponsiveImage from './ResponsiveImage.astro';
import type { ResponsiveImageProps } from '../lib/responsive-image';
import { imageSource } from '../lib/image-source';

type Props = Omit<ResponsiveImageProps, 'src'> & { src: string };
const { src, alt, width, height, ...presentation } = Astro.props;
const image = await imageSource(src, Astro.url.origin, Astro.locals.emdash?.storage, width, height);
---
<ResponsiveImage {...presentation} alt={alt} src={image.src} originalSrc={src} width={image.width} height={image.height} />
