---
import type { HTMLAttributes } from 'astro/types';
import { randomUUID } from 'node:crypto';
import { resolveFormTransport, type FormActionConfig } from '../lib/form-transport';

export interface Props extends Omit<HTMLAttributes<'form'>, 'action'> {
  /** Target endpoint string or Action handler */
  action?: FormActionConfig;
  /** HTTP method; defaults to POST */
  method?: string;
  /** Whether to progressively enhance with fetch and accessible feedback */
  enhance?: boolean;
  /** Custom success message (renders in default slot if no custom success provided) */
  successMessage?: string;
  /** Custom error message fallback */
  errorMessage?: string;
}

const {
  id: rawId,
  action: actionProp,
  method = 'POST',
  enhance = true,
  successMessage = 'Thank you! Your submission has been received.',
  errorMessage = 'An error occurred while submitting the form. Please try again.',
  class: className,
  ...rest
} = Astro.props;

const id = typeof rawId === 'string' && /^[A-Za-z][\w:.-]*$/.test(rawId) ? rawId : `form-${randomUUID()}`;
const transport = resolveFormTransport(actionProp);
---

<div id={`${id}-container`} class:list={['form-container', className]} data-form-container>
  <div
    data-form-success
    class="form-success flow"
    role="status"
    aria-live="polite"
    hidden
  >
    <slot name="success">
      <p>{successMessage}</p>
    </slot>
  </div>

  <form
    id={id}
    method={method.toUpperCase()}
    action={transport.action || undefined}
    data-form-rpc={transport.rpcAction || undefined}
    data-form-enhanced={enhance ? '' : undefined}
    data-error-message={errorMessage}
    class="flow"
    {...rest}
  >
    <div data-form-errors-slot>
      <slot name="errors" />
    </div>

    <slot />
  </form>
</div>

<script>
  function setupForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-form-enhanced]').forEach((form) => {
      if (form.dataset.formBound) return;
      form.dataset.formBound = 'true';

      const container = form.closest('[data-form-container]');
      const successBox = container?.querySelector<HTMLElement>('[data-form-success]');
      const errorsSlot = form.querySelector<HTMLElement>('[data-form-errors-slot]');
      const defaultErrorMsg = form.dataset.errorMessage || 'An error occurred while submitting the form. Please try again.';

      form.addEventListener('submit', async (event) => {
        // Native constraint validation
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        // Prevent duplicate concurrent / keyboard submissions
        if (form.dataset.formSubmitting === 'true') {
          event.preventDefault();
          return;
        }

        // Determine submitter and effective method, action, and enctype overrides
        const submitter = event.submitter as (HTMLButtonElement | HTMLInputElement | null);
        const effectiveMethod = (
          submitter?.getAttribute('formmethod') ||
          form.getAttribute('method') ||
          'POST'
        ).toUpperCase();

        const overrideAction = submitter?.getAttribute('formaction');
        const effectiveAction = overrideAction || form.dataset.formRpc || form.getAttribute('action');
        const effectiveEnctype = submitter?.getAttribute('formenctype') || form.getAttribute('enctype') || 'application/x-www-form-urlencoded';

        if (!effectiveAction || effectiveAction === '#') return;

        event.preventDefault();
        form.dataset.formSubmitting = 'true';

        // Capture FormData before disabling controls (disabled controls are omitted from FormData)
        const formData = new FormData(form, submitter || undefined);

        // Track and disable all submit buttons / controls in the form
        const submitControls = Array.from(
          form.querySelectorAll<HTMLButtonElement | HTMLInputElement>(
            'button:not([type="button"]):not([type="reset"]), input[type="submit"], input[type="image"]'
          )
        );
        const priorStates = submitControls.map((ctrl) => ({
          ctrl,
          disabled: ctrl.disabled,
          ariaDisabled: ctrl.getAttribute('aria-disabled'),
        }));

        submitControls.forEach((ctrl) => {
          ctrl.setAttribute('disabled', 'true');
          ctrl.setAttribute('aria-disabled', 'true');
        });

        // Clean previous errors
        const errorSummaryId = `${form.id}-errors`;
        if (errorsSlot) {
          const oldErrors = errorsSlot.querySelector(`#${errorSummaryId}`);
          if (oldErrors) oldErrors.remove();
        }
        form.removeAttribute('aria-invalid');
        form.removeAttribute('aria-errormessage');

        // Set aria-busy
        form.setAttribute('aria-busy', 'true');

        function restoreControls() {
          form.removeAttribute('aria-busy');
          delete form.dataset.formSubmitting;
          priorStates.forEach(({ ctrl, disabled, ariaDisabled }) => {
            if (disabled) {
              ctrl.setAttribute('disabled', 'true');
            } else {
              ctrl.removeAttribute('disabled');
            }
            if (ariaDisabled !== null) {
              ctrl.setAttribute('aria-disabled', ariaDisabled);
            } else {
              ctrl.removeAttribute('aria-disabled');
            }
          });
        }

        try {
          let requestUrl = effectiveAction;
          const requestHeaders: Record<string, string> = {
            Accept: 'application/json',
          };
          const requestInit: RequestInit = {
            method: effectiveMethod,
            headers: requestHeaders,
          };

          if (effectiveMethod === 'GET') {
            const url = new URL(effectiveAction, window.location.href);
            for (const [key, val] of formData.entries()) {
              if (typeof val === 'string') {
                url.searchParams.append(key, val);
              }
            }
            requestUrl = url.toString();
          } else {
            if (effectiveEnctype === 'multipart/form-data') {
              requestInit.body = formData;
            } else {
              const params = new URLSearchParams();
              for (const [key, val] of formData.entries()) {
                if (typeof val === 'string') {
                  params.append(key, val);
                }
              }
              requestInit.body = params;
              requestHeaders['Content-Type'] = 'application/x-www-form-urlencoded';
            }
          }

          const response = await fetch(requestUrl, requestInit);

          if (!response.ok) {
            let errorData: { message?: string } | null = null;
            try {
              errorData = await response.json();
            } catch {
              // Ignore non-JSON body parse failure
            }
            throw new Error((errorData && errorData.message) || defaultErrorMsg);
          }

          // Transition to success state
          form.removeAttribute('aria-busy');
          delete form.dataset.formSubmitting;
          form.style.display = 'none';
          if (successBox) {
            successBox.removeAttribute('hidden');
            successBox.setAttribute('tabindex', '-1');
            successBox.focus();
          }
        } catch (err: unknown) {
          restoreControls();

          if (errorsSlot) {
            const errorDiv = document.createElement('div');
            errorDiv.id = errorSummaryId;
            errorDiv.setAttribute('role', 'alert');
            errorDiv.setAttribute('aria-live', 'assertive');
            errorDiv.className = 'form-errors';
            errorDiv.setAttribute('tabindex', '-1');

            const errorP = document.createElement('p');
            errorP.textContent = err instanceof Error ? err.message : defaultErrorMsg;
            errorDiv.appendChild(errorP);
            errorsSlot.appendChild(errorDiv);

            form.setAttribute('aria-invalid', 'true');
            form.setAttribute('aria-errormessage', errorSummaryId);
            errorDiv.focus();
          }
        }
      });
    });
  }

  setupForms();
  document.addEventListener('astro:page-load', setupForms);
</script>

<style>
@layer components {
  :where([aria-busy="true"]) {
    pointer-events: none;
  }

  .form-container {
    inline-size: 100%;
    max-inline-size: var(--width-reading, 65ch);
  }

  .form-success {
    padding: var(--spacing-content, 1.5rem);
    border: 1px solid var(--color-border, #ccc);
    border-radius: var(--radius-card, 0.5rem);
    background: var(--color-surface, #fff);
  }

  .form-errors {
    padding: var(--spacing-content, 1rem);
    border: 1px solid var(--color-accent, #c00);
    border-radius: var(--radius-control, 0.25rem);
    background: var(--color-surface-elevated, #fff0f0);
    color: var(--color-accent, #c00);
  }
}
</style>
