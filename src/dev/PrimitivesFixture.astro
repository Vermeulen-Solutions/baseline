---
import SiteShell from '../layouts/SiteShell.astro';
import ThemeSelect from '../components/ThemeSelect.astro';
import Tabs from '../components/Tabs.astro';
import CopyButton from '../components/CopyButton.astro';
import Announcer from '../components/Announcer.astro';
import Heading from '../components/Heading.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Callout from '../components/Callout.astro';
import Steps from '../components/Steps.astro';
import { ClientRouter } from 'astro:transitions';

if (!import.meta.env.DEV && !import.meta.env.STARTER_TEST_FIXTURES) {
  return new Response(null, { status: 404 });
}

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const navParam = Astro.url.searchParams.get('nav');
const isPageB = navParam === 'page-b';
const title = isPageB ? 'Primitives Fixture - Page B' : 'Primitives Fixture - Page A';
---

<SiteShell title={title} spacingPolicy="automatic-v2">
  <ClientRouter slot="head" />
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <header slot="header" class="site-header">
    <nav class="site-nav" aria-label="Fixture navigation">
      <ThemeSelect id="fixture-theme-select" />
      <button
        type="button"
        id="fixture-surface-toggle"
        class="btn btn--ghost"
        data-surface-toggle
        aria-label="Toggle theme"
        aria-pressed="false"
      >
        Toggle theme
      </button>
      {isPageB ? (
        <a id="nav-to-a" href="/_primitives-fixture" data-astro-prefetch="false">Navigate to Page A</a>
      ) : (
        <a id="nav-to-b" href="/_primitives-fixture?nav=page-b" data-astro-prefetch="false">Navigate to Page B</a>
      )}
    </nav>
  </header>

  <Announcer id="site-announcer" />

  <div class="flow" data-primitives-fixture>
    <h1 id="fixture-heading">{title}</h1>

    {!isPageB ? (
      <div id="fixture-content-a" class="flow">
        <div data-print-content>
          <Tabs
            id="tabset-1"
            syncKey="pkg-sync"
            label="Package manager 1"
            defaultValue="npm"
            items={[
              { value: 'npm', label: 'npm' },
              { value: 'pnpm', label: 'pnpm' },
            ]}
          >
            <div slot="npm" id="p1-npm-content" class="flow">
              <p>npm install @baseline/core</p>
            </div>
            <div slot="pnpm" id="p1-pnpm-content" class="flow">
              <p>pnpm add @baseline/core</p>
            </div>
          </Tabs>

          <Tabs
            id="tabset-2"
            syncKey="pkg-sync"
            label="Package manager 2"
            defaultValue="npm"
            items={[
              { value: 'npm', label: 'npm' },
              { value: 'pnpm', label: 'pnpm' },
            ]}
          >
            <div slot="npm" id="p2-npm-content" class="flow">
              <p>npm run dev</p>
            </div>
            <div slot="pnpm" id="p2-pnpm-content" class="flow">
              <p>pnpm dev</p>
            </div>
          </Tabs>
        </div>

        <pre id="code-sample"><code dir="auto"><span class="prompt" data-copy-exclude>$ </span>npm install @baseline/core</code></pre>

        <CopyButton
          id="test-copy-btn"
          targetId="code-sample"
          announcerId="site-announcer"
          label="Copy code"
        />

        <TableOfContents
          id="fixture-toc"
          label="On this page"
          contentId="fixture-content-a"
          headings={[
            { id: 'section-architecture', text: 'Architecture Overview', depth: 2 },
            { id: 'section-primitives', text: 'Core Primitives', depth: 3 },
            { id: 'section-execution', text: 'Execution Guide', depth: 2 },
            { id: '100%', text: '100% Target Coverage', depth: 2 },
          ]}
          spy={true}
        />

        <div class="flow" style="margin-top: 2rem;">
          <Heading level={2} id="section-architecture" anchor anchorLabel="Direct link to Architecture Overview">
            Architecture Overview
          </Heading>
          <p id="para-arch">
            Baseline adheres to the Triple Filter: multi-profile portability, zero runtime dependencies, and platform primitives over opinionated art direction.
          </p>
          <Callout id="fixture-callout" kind="tip" title="Architecture Principle">
            <p id="fixture-callout-text">Portability means preserved boundaries, not identical runtime features.</p>
          </Callout>

          <div id="long-spacer-1" style="height: 600px; padding: 1rem; background: color-mix(in oklch, currentColor 3%, transparent); border-radius: var(--radius-card);">
            <p>Extended reading content ensuring that scrolling past the heading does not drop the active highlight in the table of contents.</p>
          </div>

          <Heading level={3} id="section-primitives" anchor anchorLabel="Direct link to Core Primitives">
            Core Primitives
          </Heading>
          <Steps
            id="fixture-steps"
            label="Primitive Setup Steps"
            items={[
              { value: 'step-headings', title: 'Mount Headings' },
              { value: 'step-toc', title: 'Attach Table of Contents' },
            ]}
          >
            <p slot="step-headings" id="step-headings-content">Render semantic h1-h6 elements with accessible permalink anchors.</p>
            <p slot="step-toc" id="step-toc-content">Progressively enhance with zero-JS nested ol fallback and pure-DOM scroll spy.</p>
          </Steps>

          <div id="long-spacer-2" style="height: 600px; padding: 1rem; background: color-mix(in oklch, currentColor 3%, transparent); border-radius: var(--radius-card);">
            <p>Second extended reading section to verify scroll spy transitions between subsections and major sections.</p>
          </div>

          <Heading level={2} id="section-execution" anchor anchorLabel="Direct link to Execution Guide">
            Execution Guide
          </Heading>
          <p id="para-exec">
            Execute verification commands to ensure zero console errors across all profiles.
          </p>

          <Heading level={2} id="100%" anchor anchorLabel="Direct link to 100% Target Coverage">
            100% Target Coverage
          </Heading>
          <p id="para-100">
            Target coverage verified without percent-decoding runtime exceptions.
          </p>
        </div>
      </div>
    ) : (
      <div id="fixture-content-b" class="flow">
        <p id="page-b-marker">Rendered Page B Content</p>
      </div>
    )}
  </div>
</SiteShell>
