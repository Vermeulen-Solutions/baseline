---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext, type CreatePublicPageContextInput } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { defaultCanonicalUrl, resolvePublicSiteUrl } from "../utils/page-metadata";
import SiteShell from "./SiteShell.astro";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	pageType?: CreatePublicPageContextInput['pageType'];
	articleMeta?: CreatePublicPageContextInput['articleMeta'];
	seo?: CreatePublicPageContextInput['seo'];
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content, pageType = 'website', articleMeta, seo } = Astro.props;
const { data: settings, cacheHint: settingsCacheHint } = await getSiteSettingsWithCacheHint();
const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settings);
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const siteUrl = resolvePublicSiteUrl(settings.url, Astro.site, Astro.url);
// Undefined uses the public default; explicit null lets error pages opt out.
const pageCanonical = canonical === undefined ? defaultCanonicalUrl(siteUrl, Astro.url.pathname) : canonical;

const { data: menu, cacheHint: menuCacheHint } = await getMenuWithCacheHint("primary");
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsCacheHint);
	Astro.cache.set(menuCacheHint);
}

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: pageCanonical,
	image,
	articleMeta,
	seo,
	content,
	siteName: siteTitle,
	siteUrl,
});
---

<SiteShell spacingPolicy="automatic-v2" title={fullTitle} metadataOwner="platform" lang={Astro.currentLocale ?? 'en'}>
		<EmDashHead slot="head" page={pageCtx} />
		<EmDashBodyStart slot="body-start" page={pageCtx} />

		<header slot="header" class="site-header">
			<nav class="site-nav" aria-label="Primary navigation">
				<a class="site-brand" href="/" aria-label={`${siteTitle} home`}>
					{siteLogo
						? <img class="site-logo" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						: siteTitle
					}
				</a>
				{
					menu?.items.map((item) => (
						<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>
							{item.label}
						</a>
					))
				}
				<LiveSearch placeholder="Search..." collections={["posts", "pages"]} />
			</nav>
		</header>

		<slot />

		<footer slot="footer" class="site-footer">
			<WidgetArea name="sidebar" class="grid-auto" />
		</footer>

		<EmDashBodyEnd slot="body-end" page={pageCtx} />
</SiteShell>
