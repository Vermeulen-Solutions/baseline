---
import { getMenuWithCacheHint, getRequestContext, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext, type CreatePublicPageContextInput } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { defaultCanonicalUrl, resolvePublicSiteUrl } from "../utils/page-metadata";
import SiteShell from "./SiteShell.astro";
// Opt-in composition, type and motion capabilities; nothing applies until a page uses them.
import "../styles/expressive.css";
import Analytics from "../components/Analytics.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	pageType?: CreatePublicPageContextInput['pageType'];
	articleMeta?: CreatePublicPageContextInput['articleMeta'];
	seo?: CreatePublicPageContextInput['seo'];
	breadcrumbs?: CreatePublicPageContextInput['breadcrumbs'];
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	surface?: 'light' | 'dark' | 'system';
}

const { title, pageTitle, description, image, canonical, content, pageType = 'website', articleMeta, seo, breadcrumbs, surface } = Astro.props;
const [
	{ data: settings, cacheHint: settingsCacheHint },
	{ data: menu, cacheHint: menuCacheHint },
] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settings);
// The site name is added when the whole title fits the 60 characters search results show (and
// check:quality enforces); a longer page title stands alone, the name is still in og:site_name.
const brandedTitle = `${title} — ${siteTitle}`;
const fullTitle = title.includes(siteTitle) || brandedTitle.length > 60 ? title : brandedTitle;
const pageDescription = description ?? siteTagline;
const siteUrl = resolvePublicSiteUrl(settings.url, Astro.site, Astro.url);
const publicBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
const fallbackFavicon = `${publicBase}/favicon.svg`;
// Undefined uses the public default; explicit null lets error pages opt out.
const pageCanonical = canonical === undefined ? defaultCanonicalUrl(siteUrl, Astro.url.pathname) : canonical;

if (Astro.cache?.enabled) {
	Astro.cache.set(settingsCacheHint);
	Astro.cache.set(menuCacheHint);
}

// Cross-document page transitions and link prefetch for visitors; the visual editor keeps plain
// navigation. A site that adds <ClientRouter /> sets both to off (see docs/design-framework.md).
const editMode = getRequestContext()?.editMode === true;
const pageTransitions = editMode ? 'none' : 'cross-document';
const prefetch = editMode ? 'off' : 'moderate';

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: pageCanonical,
	image,
	articleMeta,
	seo,
	content,
	breadcrumbs,
	siteName: siteTitle,
	siteUrl,
});
---

<SiteShell spacingPolicy="automatic-v2" sectionJoins="shared" pageTransitions={pageTransitions} prefetch={prefetch} title={fullTitle} metadataOwner="platform" lang={Astro.currentLocale ?? 'en'} surface={surface}>
		<Fragment slot="head">
			<EmDashHead page={pageCtx} />
			{!settings.favicon?.url && <link rel="icon" type="image/svg+xml" href={fallbackFavicon} />}
			{/* From `npm run icons`: the home-screen icon iOS asks for, and the manifest with the app icons. */}
			<link rel="apple-touch-icon" href={`${publicBase}/apple-touch-icon.png`} />
			<link rel="manifest" href={`${publicBase}/site.webmanifest`} />
		</Fragment>
		<EmDashBodyStart slot="body-start" page={pageCtx} />

		<header slot="header" class="site-header" data-sticky-header data-vt-header>
			<nav class="site-nav" aria-label="Primary navigation">
				<a class="site-brand" href="/" aria-label={`${siteTitle} home`}>
					{siteLogo
						? <img class="site-logo" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						: siteTitle
					}
				</a>
				{/* One disclosure holds the links and the search field: a Menu control on phones, the same
				    elements inline from 48rem (see .site-menu in global.css). It works without JavaScript. */}
				<details class="site-menu">
					<summary class="site-menu__toggle">Menu</summary>
					<div class="site-menu__panel">
						{
							menu?.items.map((item) => (
								<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>
									{item.label}
								</a>
							))
						}
						<LiveSearch placeholder="Search..." collections={["posts", "pages"]} resultsClass="site-menu__results" />
					</div>
				</details>
			</nav>
		</header>

		<slot />

		<footer slot="footer" class="site-footer">
			<WidgetArea name="sidebar" class="grid-auto" />
		</footer>

		<EmDashBodyEnd slot="body-end" page={pageCtx} />
		{/* Nothing renders until PUBLIC_GA_ID, PUBLIC_GTM_ID or PUBLIC_CF_BEACON_TOKEN is set (src/lib/consent.ts). */}
		<Analytics slot="body-end" />
		<ConsentBanner slot="body-end" />
</SiteShell>
